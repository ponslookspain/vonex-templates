---
import Icon from './Icon.astro';
import type { IconName } from './icons';

// Icon that sits inside a line of large text (the tagline), aligned to the capital letters.
interface Props {
  name: Extract<IconName, 'pick' | 'remix' | 'make' | 'ship'>;
  tone?: 'default' | 'accent';
}
const { name, tone = 'default' } = Astro.props;
---

<span class:list={['inline-icon', tone === 'accent' && 'inline-icon-accent']}>
  <Icon name={name} />
</span>
