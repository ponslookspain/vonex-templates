---
// The only way to make a button or button-like link. Renders <a> when `href` is set.
interface Props {
  href?: string;
  variant?: 'primary' | 'ghost';
  // compact is smaller on phones and regular from 640px (used in the header).
  size?: 'md' | 'compact';
  class?: string;
  [key: string]: unknown;
}
const { href, variant = 'primary', size = 'md', class: className, ...rest } = Astro.props;
const classes = ['btn', `btn-${variant}`, size === 'compact' && 'btn-compact', className];
---

{
  href ? (
    <a href={href} class:list={classes} {...rest}>
      <slot />
    </a>
  ) : (
    <button type="button" class:list={classes} {...rest}>
      <slot />
    </button>
  )
}
