---
// Outermost wrapper of page content. Sets the max width and the side padding (tokens
// --container-page and --space-page). Put a `.grid-12` inside it for the 12-column grid.
interface Props {
  as?: keyof HTMLElementTagNameMap;
  class?: string;
}
const { as: Tag = 'div', class: className } = Astro.props;
---

<Tag class:list={['container-page', className]}>
  <slot />
</Tag>
