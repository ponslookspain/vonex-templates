---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Logo from './Logo.astro';

interface Props {
  templates: CollectionEntry<'templates'>[];
}
const { templates } = Astro.props;

// Repeat the catalog until one strip is wider than a wide screen, then render it twice for a seamless loop.
const strip = Array.from({ length: Math.max(1, Math.ceil(8 / templates.length)) }, () => templates).flat();
---

<div class="hero-stage relative h-full w-full" aria-hidden="true" data-pause-offscreen>
  <div class="marquee absolute inset-x-0 top-1/2 -translate-y-1/2 overflow-hidden">
    <div class="marquee-track flex w-max">
      {
        [0, 1].map((copy) => (
          <div class="marquee-set flex shrink-0">
            {strip.map((t) => (
              <div class="marquee-card relative aspect-[4/3] shrink-0 overflow-hidden rounded-media bg-surface">
                <Image
                  src={t.data.image}
                  alt=""
                  widths={[360, 540]}
                  sizes="340px"
                  loading={copy === 0 ? 'eager' : 'lazy'}
                  class="h-full w-full object-cover"
                />
              </div>
            ))}
          </div>
        ))
      }
    </div>
    <div class="pointer-events-none absolute inset-y-0 left-0 w-1/5 bg-gradient-to-r from-bg to-transparent"></div>
    <div class="pointer-events-none absolute inset-y-0 right-0 w-1/5 bg-gradient-to-l from-bg to-transparent"></div>
  </div>
  <div class="logo-shade pointer-events-none absolute inset-0"></div>
  <div class="logo-fallback pointer-events-none absolute inset-0 grid place-items-center">
    <Logo class="h-[68%] w-auto text-fg" />
  </div>
  <canvas class="hero-logo pointer-events-none absolute inset-0 h-full w-full"></canvas>
</div>

<style>
  .marquee-card {
    width: clamp(220px, 24vw, 340px);
    box-shadow: inset 0 0 0 1px var(--color-outline);
  }
  /* Static logo while the 3D one loads; cross-fades once the first 3D frame is drawn. */
  .logo-fallback,
  .hero-logo {
    transition: opacity var(--duration-slow) var(--ease-soft);
  }
  .hero-logo {
    opacity: 0;
  }
  .hero-stage[data-ready] .hero-logo {
    opacity: 1;
  }
  .hero-stage[data-ready] .logo-fallback {
    opacity: 0;
  }
  /* Dark halo behind the logo so it stands out from the cards. */
  .logo-shade {
    background: radial-gradient(ellipse 28% 62% at 50% 50%, color-mix(in srgb, var(--color-bg) 92%, transparent) 0%, color-mix(in srgb, var(--color-bg) 75%, transparent) 45%, transparent 100%);
  }
  .marquee-track,
  .marquee-set {
    gap: var(--grid-gutter);
  }
  .marquee-track {
    animation: marquee var(--duration-marquee) linear infinite;
  }
  @keyframes marquee {
    to { transform: translateX(calc(-50% - var(--grid-gutter) / 2)); }
  }
</style>

<script>
  const stage = document.querySelector<HTMLElement>('.hero-stage');
  const canvas = document.querySelector<HTMLCanvasElement>('.hero-logo');
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;

  // Load the 3D module only after the page has finished loading and the browser is idle.
  // Until then (and with Save-Data on) the static logo is shown.
  if (stage && canvas && !saveData) {
    const start = () => import('../scripts/hero-logo').then((m) => m.startHeroLogo(canvas, stage));
    const idle = () => ('requestIdleCallback' in window ? requestIdleCallback(start, { timeout: 1000 }) : setTimeout(start, 200));
    document.readyState === 'complete' ? idle() : addEventListener('load', idle, { once: true });
  }
</script>
