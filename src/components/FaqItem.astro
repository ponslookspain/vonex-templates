---
import Icon from './Icon.astro';

// One collapsible question. Native <details>, so it works without JavaScript.
// The answer opens with a height and fade transition where the browser supports it.
interface Props {
  question: string;
}
const { question } = Astro.props;
---

<details class="faq-item">
  <summary class="type-headline-xxs flex cursor-pointer list-none items-center justify-between gap-lg py-lg">
    {question}
    <Icon name="plus" class="faq-plus size-5 shrink-0" />
  </summary>
  <p class="type-prose pb-lg"><slot /></p>
</details>
