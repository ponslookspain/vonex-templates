---
// Slowly drifting colored light. Place inside a parent with `relative overflow-hidden`.
// Colors come from the --color-accent* tokens, speeds from global.css.
---

<div aria-hidden="true" class="pointer-events-none absolute inset-0">
  <span class="glow-blob glow-blob-a"></span>
  <span class="glow-blob glow-blob-b"></span>
  <span class="glow-blob glow-blob-c"></span>
</div>
