---
// A flat block on the page background. `surface` is the regular card (steps, points,
// FAQ), `panel` is the large rounded one. Pass `class` to place it on the grid.
interface Props {
  as?: keyof HTMLElementTagNameMap;
  variant?: 'surface' | 'panel';
  // Default inner padding (--space-card). Turn off when the content sets its own.
  padded?: boolean;
  class?: string;
}
const { as: Tag = 'div', variant = 'surface', padded = true, class: className } = Astro.props;
---

<Tag class:list={[variant, padded && 'card-padding', className]}>
  <slot />
</Tag>
