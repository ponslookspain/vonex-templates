---
// Surface with a hairline border. Pass `class` to place it on the grid.
// For a row of blocks that share their borders, use the `.cells` class instead.
interface Props {
  as?: keyof HTMLElementTagNameMap;
  // Default inner padding (--space-card). Turn off when the content sets its own.
  padded?: boolean;
  class?: string;
}
const { as: Tag = 'div', padded = true, class: className } = Astro.props;
---

<Tag class:list={['card', padded && 'card-padding', className]}>
  <slot />
</Tag>
