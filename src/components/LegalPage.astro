---
import Base from '../layouts/Base.astro';
import Section from './Section.astro';

// Shared shell for the short legal pages (privacy, terms): a centered title block, then
// the title on the left and the running text on the right, on the 4-column grid.
interface Props {
  title: string;
  description: string;
  updated: string;
}
const { title, description, updated } = Astro.props;
---

<Base title={title} description={description}>
  <Section class="text-center" labelledby="legal-title">
    <span class="kicker type-label">Documents</span>
    <h1 id="legal-title" class="type-headline-lg">{title}.</h1>
    <p class="type-label mt-lg">Last updated {updated}</p>
  </Section>
  <Section rule label={title}>
    <div class="grid-4 gap-y-xl">
      <p class="type-headline-sm col-span-4 lg:col-span-1">{title}</p>
      <article class="legal type-prose col-span-4 lg:col-span-2 lg:col-start-2">
        <slot />
      </article>
    </div>
  </Section>
</Base>

<style>
  .legal :global(h2) {
    margin-top: var(--spacing-xl);
    margin-bottom: var(--spacing-md);
    font-size: var(--text-headline-xs);
    font-weight: 700;
    line-height: var(--leading-headline);
    letter-spacing: var(--tracking-headline);
    text-transform: uppercase;
  }
  .legal :global(h2:first-child) {
    margin-top: 0;
  }
  .legal :global(p + p),
  .legal :global(p + ul),
  .legal :global(ul + p) {
    margin-top: var(--spacing-md);
  }
  .legal :global(ul) {
    list-style: square;
    padding-left: var(--spacing-lg);
  }
  .legal :global(li + li) {
    margin-top: var(--spacing-xs);
  }
  .legal :global(a) {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
