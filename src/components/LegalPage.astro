---
import Base from '../layouts/Base.astro';
import Section from './Section.astro';

// Shared shell for the short legal pages (privacy, terms): one narrow column of running text.
interface Props {
  title: string;
  description: string;
  updated: string;
}
const { title, description, updated } = Astro.props;
---

<Base title={title} description={description}>
  <Section class="pt-10 sm:pt-12" labelledby="legal-title">
    <div class="grid-12">
      <article class="legal col-span-12 lg:col-span-8 lg:col-start-3">
        <h1 id="legal-title" class="type-h1">{title}</h1>
        <p class="type-small mt-3 text-muted">Last updated {updated}</p>
        <div class="type-prose mt-10">
          <slot />
        </div>
      </article>
    </div>
  </Section>
</Base>

<style>
  .legal :global(h2) {
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    color: var(--color-fg);
    font-size: var(--text-h3);
    font-weight: 600;
  }
  .legal :global(p + p),
  .legal :global(p + ul),
  .legal :global(ul + p) {
    margin-top: 1rem;
  }
  .legal :global(ul) {
    list-style: disc;
    padding-left: 1.25rem;
  }
  .legal :global(li + li) {
    margin-top: 0.5rem;
  }
  .legal :global(a) {
    color: var(--color-fg);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
