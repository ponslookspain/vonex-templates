---
import Container from './Container.astro';

// A page section: vertical rhythm from --space-section plus the page container.
// Put a SectionHeader and a `.grid-4` inside.
interface Props {
  id?: string;
  // id of the heading that names this section (for screen readers)
  labelledby?: string;
  label?: string;
  // Remove the vertical padding on one side when two sections should touch.
  flush?: 'top' | 'bottom';
  // Full-width hairline above the section.
  rule?: boolean;
  // Thin strip at the top of the section: index and name on the left, a short note on the right.
  bar?: { left: string; right?: string };
  class?: string;
}
const { id, labelledby, label, flush, rule = false, bar, class: className } = Astro.props;
---

<section
  id={id}
  aria-labelledby={labelledby}
  aria-label={labelledby ? undefined : label}
  class:list={['section', flush === 'top' && 'section-flush-top', flush === 'bottom' && 'section-flush-bottom', rule && 'section-rule', bar && 'section-with-bar', className]}
>
  <Container>
    {bar && (
      <div class="section-bar type-label" data-reveal-skip>
        <span>{bar.left}</span>
        {bar.right && <span class="text-right">{bar.right}</span>}
      </div>
    )}
    <slot />
  </Container>
</section>
