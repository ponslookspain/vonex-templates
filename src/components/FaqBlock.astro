---
// FAQ section on the page rails: the title on the left (it stays in view while you read), the
// questions on the right, split by the center line. Each question is a row whose lines run from
// that line to the rail. Put <FaqItem> children in the default slot.
import Section from './Section.astro';
import { withAccent } from '../lib/accent';

interface Props {
  title: string;
  accent?: string;
  id?: string;
  sectionId?: string;
  index?: number;
  bar?: { left: string; right?: string };
}
const { title, accent, id = 'faq-title', sectionId = 'faq', index, bar } = Astro.props;
const label = `${index !== undefined ? `${String(index).padStart(2, '0')} / ` : ''}FAQ`;
---

<Section id={sectionId} labelledby={id} flush="bottom" bar={bar ?? { left: label }}>
  <div class="split flush-rails">
    <div class="split-cell">
      <h2 id={id} class="type-headline-lg lg:sticky lg:top-[calc(var(--space-header)+var(--spacing-xl))]" set:html={withAccent(title, accent)} />
    </div>
    <div class="faq-list">
      <slot />
    </div>
  </div>
</Section>
