---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 32 32" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
  <rect width="32" height="32" rx="8" fill="#fff" />
  <path d="M8 9.5 14.5 23" fill="none" stroke="#000" stroke-width="3.6" stroke-linecap="round" />
  <path d="M14.5 23 24 9.5" fill="none" stroke="#0099ff" stroke-width="3.6" stroke-linecap="round" />
</svg>
