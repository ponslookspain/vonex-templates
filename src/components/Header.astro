---
import { site, nav } from '../data/site';
import Logo from './Logo.astro';
import Container from './Container.astro';
import Button from './Button.astro';
import Icon from './Icon.astro';
const path = Astro.url.pathname;
---

<header class="fixed inset-x-0 top-0 z-40 border-b border-line bg-bg">
  <Container class="flex h-(--space-header) items-center justify-between gap-md">
    <a href="/" class="type-headline-xs flex shrink-0 items-center gap-sm whitespace-nowrap">
      <Logo class="h-6 w-auto" />
      <span>{site.name}</span>
    </a>

    <nav aria-label="Main" class="type-label hidden items-center gap-xl md:flex">
      {
        nav.map((item) => (
          <a
            href={item.href}
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noopener noreferrer' : undefined}
            aria-current={path === item.href ? 'page' : undefined}
            class="py-xs underline-offset-[6px] hover:underline aria-[current=page]:underline"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-xs">
      <Button href="/templates/" size="compact" arrow class="hidden sm:inline-flex">Explore</Button>
      <button
        type="button"
        id="menu-toggle"
        class="grid size-10 shrink-0 place-items-center md:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="menu" class="menu-open size-6" />
        <Icon name="x" class="menu-close size-6" />
      </button>
    </div>
  </Container>

  <div id="mobile-menu" hidden class="border-t border-line bg-bg md:hidden">
    <Container as="nav" class="flex flex-col py-md">
      {
        [...nav, { label: 'Explore templates', href: '/templates/' }].map((item) => (
          <a
            href={item.href}
            aria-current={path === item.href ? 'page' : undefined}
            class="type-headline-md border-b border-line py-md last:border-b-0"
          >
            {item.label}
          </a>
        ))
      }
    </Container>
  </div>
</header>

<style>
  #menu-toggle :global(.menu-close) { display: none; }
  #menu-toggle[aria-expanded='true'] :global(.menu-open) { display: none; }
  #menu-toggle[aria-expanded='true'] :global(.menu-close) { display: inline; }
</style>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  if (toggle && menu) {
    const set = (open: boolean) => {
      menu.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    };
    toggle.addEventListener('click', () => set(Boolean(menu.hidden)));
    menu.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) set(false); });
    addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
    matchMedia('(min-width: 768px)').addEventListener('change', (e) => { if (e.matches) set(false); });
  }
</script>
