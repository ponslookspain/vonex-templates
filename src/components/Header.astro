---
import { site, nav } from '../data/site';
import SocialIcon from './SocialIcon.astro';
const path = Astro.url.pathname;
---

<header class="fixed inset-x-0 top-0 z-40 bg-gradient-to-b from-bg via-bg/80 to-transparent pb-5 pt-4">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5">
    <a href="/" class="text-lg font-extrabold uppercase tracking-tight">{site.name}</a>

    <div class="flex items-center gap-1 text-sm sm:gap-2">
      <nav aria-label="Main" class="hidden items-center md:flex">
        {
          nav.map((item) => (
            <a
              href={item.href}
              target={item.external ? '_blank' : undefined}
              rel={item.external ? 'noopener noreferrer' : undefined}
              aria-current={path === item.href ? 'page' : undefined}
              class="px-3 py-2 text-fg/80 transition-colors hover:text-fg aria-[current=page]:text-fg"
            >
              {item.label}
            </a>
          ))
        }
      </nav>
      <ul class="mr-1 hidden items-center lg:flex">
        {
          site.socials.map((s) => (
            <li>
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={s.label}
                class="grid size-9 place-items-center text-muted transition-colors hover:text-fg"
              >
                <SocialIcon name={s.icon} class="size-[17px]" />
              </a>
            </li>
          ))
        }
      </ul>
      <a href="/templates/" class="btn">Browse templates</a>
    </div>
  </div>
</header>
