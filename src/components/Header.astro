---
import { site, nav } from '../data/site';
const path = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-line/70 bg-bg/80 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5">
    <a href="/" class="text-[15px] font-semibold tracking-tight">{site.name}</a>
    <nav aria-label="Main" class="flex items-center gap-1 text-sm">
      {
        nav.map((item) => (
          <a
            href={item.href}
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noopener noreferrer' : undefined}
            aria-current={path === item.href ? 'page' : undefined}
            class="rounded-md px-3 py-2 text-muted transition-colors hover:text-fg aria-[current=page]:text-fg"
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
