---
import { site, nav } from '../data/site';
import SocialIcon from './SocialIcon.astro';
const path = Astro.url.pathname;
---

<header class="fixed inset-x-0 top-0 z-40 bg-gradient-to-b from-bg via-bg/80 to-transparent pb-5 pt-4 sm:pt-6">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-4 gap-y-3 px-5">
    <a href="/" class="text-[17px] font-semibold tracking-tight">{site.name}</a>

    <nav
      aria-label="Main"
      class="order-3 flex w-full items-center justify-center gap-1 rounded-full border border-line bg-surface/70 p-1.5 text-sm backdrop-blur-md md:order-none md:w-auto"
    >
      {
        nav.map((item) => (
          <a
            href={item.href}
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noopener noreferrer' : undefined}
            aria-current={path === item.href ? 'page' : undefined}
            class="rounded-full px-4 py-2 text-muted transition-colors hover:text-fg aria-[current=page]:bg-fg aria-[current=page]:text-bg"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <ul class="mr-1 hidden items-center gap-1 lg:flex">
        {
          site.socials.map((s) => (
            <li>
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={s.label}
                class="grid size-9 place-items-center rounded-full text-muted transition-colors hover:text-fg"
              >
                <SocialIcon name={s.icon} class="size-[17px]" />
              </a>
            </li>
          ))
        }
      </ul>
      <a
        href="/templates/"
        class="group flex items-center gap-3 rounded-full border border-line bg-surface/70 py-1.5 pl-5 pr-1.5 text-sm backdrop-blur-md transition-colors hover:border-white/30"
      >
        Browse templates
        <span class="grid size-8 place-items-center rounded-full bg-fg text-bg transition-transform group-hover:translate-x-0.5" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</header>
