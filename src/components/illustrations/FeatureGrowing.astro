---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import type { CollectionEntry } from 'astro:content';

// The catalog today plus an empty slot where the next template goes.
interface Props {
  templates: CollectionEntry<'templates'>[];
}
const shown = Astro.props.templates.slice(0, 3);
---

<div class="absolute inset-0 flex items-center justify-center gap-3 px-5">
  {
    shown.map((t) => (
      <div class="relative aspect-[4/3] w-[22%] overflow-hidden rounded-control ring-1 ring-outline-strong">
        <Image src={t.data.image} alt="" widths={[160, 320]} sizes="120px" class="h-full w-full object-cover" />
      </div>
    ))
  }
  <div class="relative grid aspect-[4/3] w-[22%] place-items-center rounded-control border border-dashed border-outline-strong text-accent">
    <Icon name="plus" class="size-5" />
    <span class="badge badge-success absolute -right-1.5 -top-2">New</span>
  </div>
</div>
