---
// The catalog today plus a tile that keeps arriving.
---

<div class="absolute inset-0 flex items-center justify-center gap-3 px-6">
  {
    [0, 1, 2].map(() => (
      <div class="ill-tile w-[21%] p-2.5">
        <div class="ill-line w-3/5"></div>
        <div class="ill-block mt-2.5 aspect-[4/3]"></div>
      </div>
    ))
  }
  <div class="ill-tile ill-tile-accent ill-new w-[21%] p-2.5">
    <div class="ill-line ill-line-accent w-3/5"></div>
    <div class="ill-block ill-block-accent mt-2.5 aspect-[4/3]"></div>
  </div>
</div>
