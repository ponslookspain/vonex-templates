---
// Step 1: three flat tiles, the highlight moves from one to the next.
---

<div class="absolute inset-0 flex items-center justify-center gap-3 px-6">
  {
    [0, 1, 2].map((i) => (
      <div class="ill-tile ill-pick w-[28%] p-2.5" style={`animation-delay: ${i * 3}s`}>
        <div class="ill-line w-3/5"></div>
        <div class="ill-block mt-2.5 aspect-[4/3]"></div>
      </div>
    ))
  }
</div>
