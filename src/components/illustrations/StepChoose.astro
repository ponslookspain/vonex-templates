---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import type { CollectionEntry } from 'astro:content';

// Step 1: a row of template previews, the middle one selected, with a cursor.
interface Props {
  templates: CollectionEntry<'templates'>[];
}
const shown = Astro.props.templates.slice(0, 3);
---

<div class="absolute inset-0 flex items-center justify-center gap-2.5 px-4">
  {
    shown.map((t, i) => (
      <div
        class:list={[
          'relative aspect-[4/3] w-[30%] overflow-hidden rounded-control',
          i === 1 ? 'z-10 scale-110 shadow-lg ring-2 ring-accent' : 'scale-95 opacity-80 ring-1 ring-outline-strong',
        ]}
      >
        <Image src={t.data.image} alt="" widths={[160, 320]} sizes="140px" class="h-full w-full object-cover" />
      </div>
    ))
  }
  <span class="anim-float pointer-events-none absolute left-[55%] top-[56%] z-20">
    <Icon name="pick" class="size-8 fill-bg stroke-fg drop-shadow-lg" />
  </span>
</div>
