---
import Icon from '../Icon.astro';

// Step 3: a small browser window with a live site.
---

<div class="absolute inset-0 flex items-center justify-center px-5">
  <div class="mini-window w-full max-w-[17rem] overflow-hidden p-0">
    <div class="flex items-center gap-1.5 border-b border-outline px-3 py-2">
      <span class="size-1.5 rounded-full bg-fg/20"></span>
      <span class="size-1.5 rounded-full bg-fg/20"></span>
      <span class="size-1.5 rounded-full bg-fg/20"></span>
      <span class="type-caption ml-2 flex flex-1 items-center gap-1 rounded-full bg-surface-2 px-2 py-0.5 text-muted">
        <Icon name="lock" class="size-3" /> yourdomain.com
      </span>
    </div>
    <div class="relative p-3">
      <span class="badge badge-success absolute right-3 top-3 inline-flex items-center gap-1">
        <span class="anim-pulse size-1.5 rounded-full bg-success"></span> Live
      </span>
      <div class="skeleton h-2.5 w-1/2"></div>
      <div class="skeleton mt-3 w-4/5"></div>
      <div class="skeleton mt-1.5 w-3/5"></div>
      <div class="mt-4 h-6 w-20 rounded-control bg-accent"></div>
    </div>
  </div>
</div>
