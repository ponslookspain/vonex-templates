---
// Laptop and phone side by side: one design, every screen.
---

<div class="absolute inset-0 flex items-end justify-center gap-4 px-6 pt-8">
  <div class="mini-window h-[78%] w-[62%] max-w-[20rem] overflow-hidden rounded-b-none p-0">
    <div class="flex items-center gap-1.5 border-b border-outline px-3 py-2">
      <span class="size-1.5 rounded-full bg-fg/20"></span>
      <span class="size-1.5 rounded-full bg-fg/20"></span>
      <span class="size-1.5 rounded-full bg-fg/20"></span>
    </div>
    <div class="p-3">
      <div class="h-14 rounded-[0.35rem] bg-gradient-to-br from-accent/60 to-accent-indigo/50"></div>
      <div class="skeleton mt-3 w-2/3"></div>
      <div class="mt-3 grid grid-cols-3 gap-2">
        <div class="aspect-[4/3] rounded-[0.3rem] bg-surface-2"></div>
        <div class="aspect-[4/3] rounded-[0.3rem] bg-surface-2"></div>
        <div class="aspect-[4/3] rounded-[0.3rem] bg-surface-2"></div>
      </div>
    </div>
  </div>
  <div class="mini-window h-[90%] w-[22%] max-w-[6.5rem] rounded-b-none p-2">
    <div class="mx-auto h-1 w-6 rounded-full bg-fg/20"></div>
    <div class="mt-2.5 h-10 rounded-[0.3rem] bg-gradient-to-br from-accent/60 to-accent-indigo/50"></div>
    <div class="skeleton mt-2.5 w-4/5"></div>
    <div class="skeleton mt-1.5 w-3/5"></div>
    <div class="mt-3 aspect-square rounded-[0.3rem] bg-surface-2"></div>
  </div>
</div>
