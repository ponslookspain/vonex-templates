---
// One layout that reflows as the screen narrows: wide, tablet, phone.
---

<div class="absolute inset-0 flex justify-center px-6 pt-8">
  <div class="ill-tile ill-resize h-full rounded-b-none p-3">
    <div class="ill-line w-1/3"></div>
    <div class="ill-block ill-block-accent mt-3 h-12"></div>
    <div class="mt-3 flex flex-wrap gap-2">
      <div class="ill-block aspect-[4/3] flex-1 basis-[4.5rem]"></div>
      <div class="ill-block aspect-[4/3] flex-1 basis-[4.5rem]"></div>
      <div class="ill-block aspect-[4/3] flex-1 basis-[4.5rem]"></div>
    </div>
  </div>
</div>
