---
// Editing without code: a headline types itself in.
---

<div class="absolute inset-0 grid place-items-center px-6">
  <div class="ill-tile w-full max-w-[15rem] p-4">
    <p class="type-caption text-muted">Headline</p>
    <p class="type-h3 mt-2 flex items-center">
      <span class="ill-type">Your headline</span><span class="anim-caret ml-0.5 h-5 w-0.5 bg-accent"></span>
    </p>
    <div class="ill-line mt-4 w-full"></div>
    <div class="ill-line mt-2 w-3/5"></div>
  </div>
</div>
