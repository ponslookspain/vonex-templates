---
// A visual editor: edit a headline and pick a color, no code.
---

<div class="absolute inset-0 grid place-items-center px-6">
  <div class="mini-window w-full max-w-[16rem] p-3">
    <p class="type-caption text-muted">Headline</p>
    <div class="type-small mt-2 rounded-control bg-surface-2 px-3 py-2 shadow-[inset_0_0_0_1px_var(--color-accent)]">
      Your headline<span class="anim-caret ml-0.5 inline-block h-4 w-px translate-y-0.5 bg-accent"></span>
    </div>
    <p class="type-caption mt-3 text-muted">Color</p>
    <div class="mt-2 flex items-center gap-2.5">
      <span class="size-5 rounded-full bg-accent ring-2 ring-fg ring-offset-2 ring-offset-surface"></span>
      <span class="size-5 rounded-full bg-accent-indigo"></span>
      <span class="size-5 rounded-full bg-accent-sky"></span>
      <span class="size-5 rounded-full bg-accent-violet"></span>
    </div>
  </div>
</div>
