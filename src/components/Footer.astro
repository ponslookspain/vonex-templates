---
import { site } from '../data/site';
import Container from './Container.astro';
const year = new Date().getFullYear();

type Link = { label: string; href: string; external?: boolean };
const columns: { title: string; links: Link[] }[] = [
  {
    title: 'Catalog',
    links: [
      { label: 'All templates', href: '/templates/' },
      { label: 'Framer profile', href: site.framerProfile, external: true },
    ],
  },
  { title: 'Follow', links: site.socials.map((s) => ({ label: s.label, href: s.href, external: true })) },
  {
    title: 'More',
    links: [
      { label: 'Privacy', href: '/privacy/' },
      { label: 'Terms', href: '/terms/' },
    ],
  },
];
---

<footer class="border-t border-line">
  <Container class="grid-4 gap-y-xl py-2xl">
    <div class="col-span-4 lg:col-span-1">
      <p class="type-headline-lg">Vonex</p>
      <p class="type-body type-pillar mt-lg">{site.tagline}</p>
    </div>
    {
      columns.map((col) => (
        <div class="col-span-2 md:col-span-1">
          <p class="type-headline-xxs mb-lg">{col.title}</p>
          <ul class="type-label flex flex-col gap-md">
            {col.links.map((l) => (
              <li>
                <a
                  class="underline-offset-4 hover:underline"
                  href={l.href}
                  target={l.external ? '_blank' : undefined}
                  rel={l.external ? 'noopener noreferrer' : undefined}
                >
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </Container>
  <Container class="type-label">
    <div class="flex flex-col gap-xs border-t border-line py-lg sm:flex-row sm:justify-between">
      <span>© {year} {site.name}</span>
      <a class="underline-offset-4 hover:underline" href={`mailto:${site.email}`}>{site.email}</a>
    </div>
  </Container>
</footer>
