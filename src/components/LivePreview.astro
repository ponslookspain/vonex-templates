---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Button from './Button.astro';

// The live demo inside the page, ready to scroll from 1024px. On phones a picture links to the
// full demo instead: a site inside a small frame is hard to scroll. The demo starts after the
// page has loaded, so it does not hold back the page itself.
interface Props {
  url: string;
  name: string;
  poster: ImageMetadata;
}
const { url, name, poster } = Astro.props;
const modes = [
  { label: 'Desktop', width: 1440 },
  { label: 'Tablet', width: 810 },
  { label: 'Phone', width: 390 },
];
---

<div class="live" id="live-preview" data-live data-url={url} data-name={name}>
  <div class="live-bar type-label">
    <div class="live-modes" role="group" aria-label="Preview size">
      {modes.map((m, i) => (
        <button type="button" class="live-mode" data-width={m.width} aria-pressed={i === 0 ? 'true' : 'false'}>{m.label}</button>
      ))}
    </div>
    <a href={url} class="live-open" target="_blank" rel="noopener noreferrer">Open full site ↗</a>
  </div>
  <div class="live-stage" data-stage>
    <Image src={poster} alt={`${name} template home page`} widths={[640, 960, 1400]} sizes="(min-width: 1024px) 75vw, 100vw" loading="lazy" class="live-poster" />
    <div class="live-start">
      <Button href={url} class="live-link" arrow target="_blank" rel="noopener noreferrer">Open live preview</Button>
    </div>
  </div>
</div>

<style>
  .live {
    scroll-margin-top: var(--space-header);
    min-width: 0;
  }
  .live-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-md);
    padding: var(--spacing-sm) var(--rail-inset);
    border-bottom: var(--border-hairline) solid var(--color-line);
  }
  .live-modes {
    display: none;
    gap: var(--spacing-lg);
  }
  .live-mode {
    color: var(--color-muted);
    text-transform: inherit;
    letter-spacing: inherit;
    cursor: pointer;
  }
  .live-mode[aria-pressed='true'] {
    color: var(--color-fg);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .live-open:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .live-stage {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--color-primary);
  }
  .live-poster {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .live-start {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: var(--spacing-lg);
  }
  .live-stage :global(iframe) {
    position: absolute;
    top: 0;
    left: 50%;
    border: 0;
    background: var(--color-bg);
    transform-origin: top center;
  }
  @media (min-width: 64rem) {
    .live-modes {
      display: flex;
    }
    /* Shorter than the window, so the page around the frame can still be reached and scrolled. */
    .live-stage {
      aspect-ratio: auto;
      height: min(72vh, 46rem);
      background: var(--color-bg);
    }
    .live-poster,
    .live-start {
      display: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-live]').forEach((root) => {
    const stage = root.querySelector<HTMLElement>('[data-stage]')!;
    const modes = [...root.querySelectorAll<HTMLButtonElement>('[data-width]')];
    let frame: HTMLIFrameElement | undefined;
    let width = 1440;

    // The demo is laid out at a real screen width and scaled down, so Framer shows the matching
    // breakpoint instead of its tablet layout in a narrower column.
    const fit = () => {
      if (!frame) return;
      const scale = Math.min(1, stage.clientWidth / width);
      frame.style.width = `${width}px`;
      frame.style.height = `${stage.clientHeight / scale}px`;
      frame.style.transform = `translateX(-50%) scale(${scale})`;
    };

    const start = () => {
      if (frame) return;
      frame = document.createElement('iframe');
      frame.src = root.dataset.url!;
      frame.title = `${root.dataset.name} live preview`;
      frame.setAttribute('sandbox', 'allow-scripts allow-same-origin allow-popups allow-forms');
      stage.append(frame);
      fit();
    };

    const large = matchMedia('(min-width: 64rem)');
    const startOnLarge = () => {
      if (large.matches) start();
    };
    if (document.readyState === 'complete') startOnLarge();
    else addEventListener('load', startOnLarge, { once: true });
    large.addEventListener('change', startOnLarge);
    modes.forEach((button) =>
      button.addEventListener('click', () => {
        width = Number(button.dataset.width);
        modes.forEach((m) => m.setAttribute('aria-pressed', String(m === button)));
        fit();
      }),
    );
    new ResizeObserver(fit).observe(stage);
  });
</script>
