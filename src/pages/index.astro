---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import TemplateCard from '../components/TemplateCard.astro';
import { site } from '../data/site';

const all = await getCollection('templates');
const featured = all
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.added.getTime() - a.data.added.getTime())
  .slice(0, 3);

const points = [
  { title: 'Responsive', text: 'Every template is built to look right on phone, tablet and desktop.' },
  { title: 'No code needed', text: 'Remix on Framer and edit text, images and CMS content visually.' },
  { title: 'Free and premium', text: 'Start with a free template or pick a premium one for a specific use case.' },
];
---

<Base>
  <section class="mx-auto max-w-6xl px-5 pb-16 pt-20 sm:pt-28">
    <p class="mb-5 text-sm text-accent">Framer templates by {site.name}</p>
    <h1 class="max-w-3xl text-balance text-4xl font-semibold leading-[1.05] tracking-tight sm:text-6xl">
      Minimal Framer templates for modern websites.
    </h1>
    <p class="mt-6 max-w-xl text-pretty text-lg text-muted">
      Portfolios, agencies and weddings. Pick a template, remix it on Framer and make it yours.
    </p>
    <div class="mt-9 flex flex-wrap gap-3">
      <a href="/templates/" class="rounded-full bg-fg px-5 py-3 text-sm font-medium text-bg transition hover:bg-white/85">Browse all templates</a>
      <a href={site.framerProfile} target="_blank" rel="noopener noreferrer" class="rounded-full border border-line px-5 py-3 text-sm font-medium text-fg transition hover:border-white/30">Framer profile ↗</a>
    </div>
  </section>

  <section id="templates" class="mx-auto max-w-6xl px-5 pb-8" aria-labelledby="featured-title">
    <div class="mb-6 flex items-end justify-between gap-4">
      <h2 id="featured-title" class="text-2xl font-semibold tracking-tight">Featured templates</h2>
      <a href="/templates/" class="text-sm text-muted transition hover:text-fg">View all →</a>
    </div>
    <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {featured.map((t) => <TemplateCard template={t} />)}
    </ul>
    <div class="mt-10 flex justify-center">
      <a href="/templates/" class="rounded-full border border-line px-6 py-3 text-sm font-medium transition hover:border-white/30 hover:bg-surface">View all templates</a>
    </div>
  </section>

  <section id="about" class="mx-auto max-w-6xl px-5 py-20" aria-labelledby="about-title">
    <h2 id="about-title" class="text-2xl font-semibold tracking-tight">Why Vonex Design</h2>
    <p class="mt-3 max-w-2xl text-muted">
      Templates made by {site.name} with a focus on clean typography, calm layouts and smooth details.
    </p>
    <ul class="mt-10 grid gap-5 sm:grid-cols-3">
      {points.map((p) => (
        <li class="rounded-2xl border border-line bg-surface p-6">
          <h3 class="font-medium">{p.title}</h3>
          <p class="mt-2 text-sm text-muted">{p.text}</p>
        </li>
      ))}
    </ul>
  </section>
</Base>
