---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import TemplateCard from '../components/TemplateCard.astro';
import HeroStage from '../components/HeroStage.astro';
import Container from '../components/Container.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Button from '../components/Button.astro';
import Badge from '../components/Badge.astro';
import Card from '../components/Card.astro';
import FaqItem from '../components/FaqItem.astro';
import InlineIcon from '../components/InlineIcon.astro';
import FeatureCard from '../components/FeatureCard.astro';
import StepChoose from '../components/illustrations/StepChoose.astro';
import StepRemix from '../components/illustrations/StepRemix.astro';
import StepPublish from '../components/illustrations/StepPublish.astro';
import FeatureResponsive from '../components/illustrations/FeatureResponsive.astro';
import FeatureNoCode from '../components/illustrations/FeatureNoCode.astro';
import FeaturePricing from '../components/illustrations/FeaturePricing.astro';
import FeatureGrowing from '../components/illustrations/FeatureGrowing.astro';
import { Image } from 'astro:assets';
import ctaMonitor from '../assets/cta-monitor.webp';
import { site } from '../data/site';

const all = await getCollection('templates');
const featured = all
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.added.getTime() - a.data.added.getTime())
  .slice(0, 3);

const steps = [
  { n: 1, title: 'Choose a Framer template', text: 'Browse the catalog and open the template that fits your project. Each one has a live preview.' },
  { n: 2, title: 'Remix it in Framer', text: 'One click on Framer Marketplace copies the template into your own Framer account.' },
  { n: 3, title: 'Customize and publish', text: 'Replace the text and images, adjust the style and publish your website on your own domain.' },
];

const faq = [
  { q: 'What is a Framer template?', a: 'A Framer template is a ready-made website design that you copy into your own Framer account and edit visually. The layout, styles and animations are already done, you only add your content.' },
  { q: 'How do I use a Framer template?', a: 'Open a template from the catalog, press the remix button on its Framer Marketplace page and the template is copied to your Framer account, ready to edit and publish.' },
  { q: 'Are the Framer templates free?', a: 'The catalog has both free and premium templates. The price, or the word Free, is shown on every card.' },
  { q: 'Do I need to know how to code?', a: 'No. Everything is edited visually in Framer, including text, images and CMS content.' },
  { q: 'Are the templates responsive?', a: 'Yes. Every template is built to look right on phone, tablet and desktop.' },
  { q: 'Can I use a template for my own project or client work?', a: 'Yes. After you remix a template it is your own Framer project, so you can edit it, publish it on your domain and adapt it to your needs. Check the license on the template page for the exact terms.' },
];

const points = [
  { icon: 'responsive', title: 'Responsive design', text: 'Every template is built to look right on phone, tablet and desktop.', span: 'lg:col-span-7' },
  { icon: 'blocks', title: 'No code needed', text: 'Remix on Framer and edit text, images and CMS content visually.', span: 'lg:col-span-5' },
  { icon: 'tag', title: 'Free and premium', text: 'Start with a free template or choose a premium one with more features.', span: 'lg:col-span-5' },
  { icon: 'sparkles', title: 'Always growing', text: 'The catalog keeps expanding, so there is a new design to choose from every time you visit.', span: 'lg:col-span-7' },
] as const;
---

<Base
  overlayHeader
  title="Framer Templates for Any Website"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  }}
>
  <!-- Hero: fills the first screen, text on top, 3D logo and template strip below -->
  <section class="flex h-svh min-h-[36rem] flex-col pt-36 text-center md:pt-32" aria-labelledby="hero-title">
    <Container class="flex flex-1 flex-col items-center">
      <p class="type-small mb-6 inline-flex items-center gap-2 text-fg-soft">
        <Badge>New</Badge>
        Framer templates by {site.name}
      </p>
      <h1 id="hero-title" class="type-display max-w-measure-display">Framer templates for any kind of website.</h1>
      <p class="type-lead mt-6 max-w-measure-lead">
        Ready-made, responsive designs by {site.name}. Pick a template, remix it in Framer and publish your website without writing code.
      </p>
      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <Button href="/templates/">Browse all templates</Button>
      </div>
      <div class="relative mb-[3vh] mt-6 min-h-72 w-full flex-1">
        <HeroStage templates={all} />
      </div>
    </Container>
  </section>

  <Section id="templates" labelledby="featured-title" flush="bottom">
    <SectionHeader
      id="featured-title"
      eyebrow="Framer Templates"
      title="Featured Framer templates"
      lead="Our top picks from the catalog. Open one to preview it live."
    />
    <ul class="grid-12 mt-12 gap-y-10">
      {featured.map((t) => <TemplateCard template={t} class="col-span-12 sm:col-span-6 lg:col-span-4" />)}
    </ul>
    <div class="mt-10 flex justify-center">
      <Button href="/templates/">View all templates</Button>
    </div>
  </Section>

  <Section label="Tagline" class="text-center">
    <div class="grid-12">
      <p class="type-statement col-span-12 mx-auto max-w-[64rem]">
        <span class="mx-[0.12em] whitespace-nowrap">Pick it. <InlineIcon name="pick" /></span>
        <span class="mx-[0.12em] whitespace-nowrap text-muted">Remix it. <InlineIcon name="remix" /></span><br class="hidden sm:block" />
        <span class="mx-[0.12em] whitespace-nowrap">Make it yours. <InlineIcon name="make" /></span>
        <span class="mx-[0.12em] whitespace-nowrap text-accent">Ship it. <InlineIcon name="ship" tone="accent" /></span>
      </p>
    </div>
  </Section>

  <Section id="how" labelledby="how-title" flush="bottom">
    <SectionHeader
      id="how-title"
      eyebrow="How it works"
      title="From template to live website in three steps"
      lead="Choose, remix and publish a Framer template in an afternoon."
    />
    <ol class="grid-12 mt-12">
      {steps.map((st, i) => (
        <FeatureCard as="li" step={st.n} title={st.title} text={st.text} connector={i < steps.length - 1} class="col-span-12 sm:col-span-4">
          <Fragment slot="illustration">
            {i === 0 && <StepChoose templates={all} />}
            {i === 1 && <StepRemix />}
            {i === 2 && <StepPublish />}
          </Fragment>
        </FeatureCard>
      ))}
    </ol>
  </Section>

  <Section id="about" labelledby="about-title">
    <SectionHeader
      id="about-title"
      eyebrow="Why Vonex"
      title="Why choose Vonex Framer templates"
      lead={`Framer templates by ${site.name} with clean typography, calm layouts and smooth details, ready to use from the first minute.`}
    />
    <ul class="grid-12 mt-12">
      {points.map((p, i) => (
        <FeatureCard as="li" icon={p.icon} title={p.title} text={p.text} class={`col-span-12 md:col-span-6 ${p.span}`}>
          <Fragment slot="illustration">
            {i === 0 && <FeatureResponsive />}
            {i === 1 && <FeatureNoCode />}
            {i === 2 && <FeaturePricing />}
            {i === 3 && <FeatureGrowing templates={all} />}
          </Fragment>
        </FeatureCard>
      ))}
    </ul>
  </Section>

  <Section id="faq" labelledby="faq-title" flush="top">
    <SectionHeader id="faq-title" eyebrow="FAQ" title="Everything you need to know" />
    <div class="grid-12 mt-10">
      <div class="col-span-12 flex flex-col gap-3 lg:col-span-8 lg:col-start-3">
        {faq.map((f) => <FaqItem question={f.q}>{f.a}</FaqItem>)}
      </div>
    </div>
  </Section>

  <Section labelledby="cta-title" flush="top" class="pb-24">
    <Card variant="panel" padded={false} class="cta-card relative overflow-hidden px-8 pt-14 sm:px-14 sm:pt-20 lg:pb-20">
      <div class="grid-12 relative z-10 text-center lg:text-left">
        <div class="col-span-12 lg:col-span-6">
          <h2 id="cta-title" class="type-h2 mx-auto max-w-measure-title text-balance lg:mx-0">Launch your website today</h2>
          <p class="mx-auto mt-4 max-w-measure-body text-muted lg:mx-0 lg:max-w-sm xl:max-w-md">Choose a Framer template, remix it and have your website online today.</p>
          <Button href="/templates/" class="mt-8">Discover templates</Button>
        </div>
      </div>
      <Image
        src={ctaMonitor}
        alt="A Framer template shown on a monitor"
        widths={[640, 1000, 1343]}
        quality={70}
        sizes="(min-width: 1024px) 700px, 100vw"
        class="pointer-events-none relative -mb-px -ml-[15%] mt-10 w-[130%] max-w-none md:-ml-[7.5%] md:w-[115%] lg:absolute lg:left-1/2 lg:top-[-9%] lg:m-0 lg:w-[67%]"
      />
    </Card>
  </Section>
</Base>
