---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import TemplateCard from '../components/TemplateCard.astro';
import Container from '../components/Container.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Button from '../components/Button.astro';
import FaqItem from '../components/FaqItem.astro';
import FaqBlock from '../components/FaqBlock.astro';
import Band from '../components/Band.astro';
import ColumnLines from '../components/ColumnLines.astro';
import HeroSlider from '../components/HeroSlider.astro';
import CtaBand from '../components/CtaBand.astro';
import StepVisual from '../components/StepVisual.astro';
import { site } from '../data/site';

const all = await getCollection('templates');
const featured = all
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.added.getTime() - a.data.added.getTime())
  .slice(0, 4);
// The hero slider cycles through the four first templates (featured first).
const slides = all.slice(0, 4);
const freeCount = all.filter((t) => t.data.price === 0).length;
const pad = (n: number) => String(n).padStart(2, '0');

// Short, factual claims: a number and what it measures, like a spec sheet.
const specs = [
  { value: '0', unit: 'Lines', title: 'No code', text: 'Text, images and CMS are edited visually in Framer.' },
  { value: '3', unit: 'Screens', title: 'Responsive', text: 'Each layout is set for phone, tablet and desktop.' },
  { value: '1', unit: 'Click', title: 'Remix', text: 'The template is copied into your own Framer account.' },
  { value: freeCount > 0 ? '$0' : '$', unit: 'To start', title: 'Free and premium', text: 'Start free, or pick a premium template with more pages.' },
];

const steps = [
  { title: 'Choose', text: 'Open a template and see it live before you commit.', meta: `${pad(all.length)} options`, visual: 'choose' },
  { title: 'Remix', text: 'One click on Framer copies it into your account.', meta: '1 click', visual: 'remix' },
  { title: 'Publish', text: 'Swap the text and images. Go live on your domain.', meta: '● Live', visual: 'publish' },
] as const;

const faq = [
  { q: 'What is a Framer template?', a: 'A Framer template is a ready-made website design that you copy into your own Framer account and edit visually. The layout, styles and animations are already done, you only add your content.' },
  { q: 'How do I use a Framer template?', a: 'Open a template from the catalog, press the remix button on its Framer Marketplace page and the template is copied to your Framer account, ready to edit and publish.' },
  { q: 'Are the Framer templates free?', a: 'The catalog has both free and premium templates. Every card shows whether a template is free or its price.' },
  { q: 'Do I need to know how to code?', a: 'No. Everything is edited visually in Framer, including text, images and CMS content.' },
  { q: 'Are the templates responsive?', a: 'Yes. Every template is built to look right on phone, tablet and desktop.' },
  { q: 'Can I use a template for my own project or client work?', a: 'Yes. After you remix a template it is your own Framer project, so you can edit it, publish it on your domain and adapt it to your needs. Check the license on the template page for the exact terms.' },
];
---

<Base
  title="Framer Templates for Any Website"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  }}
>
  <!-- Hero: the display headline anchors one framed cover, on the four column lines. -->
  <section class="relative isolate overflow-hidden pb-xl" aria-labelledby="hero-title">
    <ColumnLines />
    <Container>
      <!-- Each label sits on a white backing so the column lines never run through the text. -->
      <div class="type-label grid-4 py-lg">
        <span class="col-span-2 md:col-span-1"><span class="bg-bg py-xs pr-sm">Framer templates</span></span>
        <span class="hidden text-center md:col-span-2 md:block"><span class="bg-bg px-sm py-xs">{pad(all.length)} templates · {pad(freeCount)} free</span></span>
        <span class="col-span-2 text-right md:col-span-1"><span class="bg-bg py-xs pl-sm">{site.name}</span></span>
      </div>

      <h1 id="hero-title" class="type-display mt-xl bg-bg text-center">Framer<br /><em class="type-accent">templates</em>.</h1>

      <div class="grid-4 mt-xl items-end gap-y-xl">
        <div class="order-2 col-span-4 bg-bg md:order-1 md:col-span-1">
          <p class="type-body type-pillar">Ready-made websites, set in Framer. Pick one, remix it, publish it today.</p>
          <Button href="/templates/" arrow class="mt-lg">Explore</Button>
        </div>
        <HeroSlider templates={slides} class="order-1 col-span-4 md:order-2 md:col-span-2" />
        <div class="order-3 col-span-4 flex flex-col gap-sm bg-bg md:col-span-1 md:items-end">
          <Button href={slides[0].data.affiliateUrl ?? slides[0].data.url} variant="secondary" target="_blank" rel={slides[0].data.affiliateUrl ? 'noopener noreferrer sponsored' : 'noopener noreferrer'} arrow data-hero-cta>View on Framer</Button>
          <p class="type-label"><span class="bg-bg py-xs">Built in Framer · No code</span></p>
        </div>
      </div>
    </Container>
  </section>

  <Band items={['Pick it.', 'Remix it.', 'Ship it.']} />

  <Section id="templates" labelledby="featured-title" flush="bottom" bar={{ left: '01 / Featured', right: `${pad(featured.length)} of ${pad(all.length)}` }}>
    <SectionHeader id="featured-title" title="Selected templates." accent="templates">
      <Button href="/templates/" variant="secondary" arrow>View all</Button>
    </SectionHeader>
    <ul class="card-grid flush-rails">
      {featured.map((t) => <TemplateCard template={t} />)}
    </ul>
  </Section>

  <Section id="specs" labelledby="specs-title" flush="bottom" bar={{ left: '02 / Specs', right: 'Built in Framer' }}>
    <SectionHeader id="specs-title" title="Zero code. Full control." accent="control" />
    <ul class="cells cells-4 flush-rails">
      {
        specs.map((s, i) => (
          <li class="cell invert-hover flex min-h-80 flex-col justify-between gap-xl">
            <div class="type-label flex justify-between">
              <span>{pad(i + 1)}</span>
              <span>{s.unit}</span>
            </div>
            <div>
              <p class="type-headline-lg" aria-hidden="true">{s.value}</p>
              <h3 class="type-headline-xs mt-lg">{s.title}</h3>
              <p class="type-body type-pillar mt-sm">{s.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section id="how" labelledby="how-title" flush="bottom" bar={{ left: '03 / Start', right: 'Choose · Remix · Publish' }}>
    <SectionHeader id="how-title" title="Three steps to a live site." accent="live" />
    <ol class="cells cells-4 flush-rails">
      {
        steps.map((st, i) => (
          <li class="cell flex flex-col gap-xl">
            <div class="type-label flex justify-between">
              <span>Step {pad(i + 1)}</span>
              <span>{st.meta}</span>
            </div>
            <StepVisual kind={st.visual} count={all.length} />
            <div class="mt-auto">
              <h3 class="type-headline-xs">{st.title}</h3>
              <p class="type-body type-pillar mt-sm">{st.text}</p>
            </div>
          </li>
        ))
      }
      <li class="cell flex flex-col gap-xl">
        <div class="type-label flex justify-between">
          <span>Catalog</span>
          <span>Today</span>
        </div>
        <div>
          <p class="type-display" aria-hidden="true">{pad(all.length)}</p>
          <p class="type-label mt-sm">Templates ready to remix</p>
        </div>
        <dl class="stat-grid mt-auto">
          <div><dt class="type-label">Free</dt><dd class="type-headline-md">{pad(freeCount)}</dd></div>
          <div><dt class="type-label">Code</dt><dd class="type-headline-md">0</dd></div>
        </dl>
        <Button href="/templates/" arrow class="w-full">Explore</Button>
      </li>
    </ol>
  </Section>

  <FaqBlock title="Questions." accent="Questions" bar={{ left: '04 / FAQ', right: `${pad(faq.length)} answers` }}>
    {faq.map((f) => <FaqItem question={f.q}>{f.a}</FaqItem>)}
  </FaqBlock>

  <!-- Closing band: the one large black block of the page, on light rails. -->
  <CtaBand labelledby="cta-title">
    <span class="kicker type-label">05 / Launch</span>
    <h2 id="cta-title" class="type-headline-lg">Live <em class="type-accent">today</em>.<br />Not next month.</h2>
    <p class="type-body type-pillar mt-lg">Choose a template, remix it in Framer and publish before the day is out.</p>
    <div><Button href="/templates/" variant="secondary" arrow class="mt-xl">Explore</Button></div>
    {
      featured[1] && (
        <a slot="media" href={`/templates/${featured[1].id}/`} class="block border-(length:--border-frame) border-on-primary">
          <Image
            src={featured[1].data.image}
            alt={`${featured[1].data.name} Framer template`}
            widths={[640, 960, 1400]}
            sizes="(min-width: 1024px) 50vw, 100vw"
            class="aspect-[4/3] w-full object-cover"
          />
        </a>
      )
    }
  </CtaBand>
</Base>
