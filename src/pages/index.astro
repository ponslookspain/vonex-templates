---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import TemplateCard from '../components/TemplateCard.astro';
import heroMonitor from '../assets/hero-monitor.webp';
import { site } from '../data/site';

const all = await getCollection('templates');
const featured = all
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.added.getTime() - a.data.added.getTime())
  .slice(0, 3);

const steps = [
  { n: 1, title: 'Choose a template', text: 'Browse the collection and open the one that fits your project.' },
  { n: 2, title: 'Remix it in Framer', text: 'One click on Framer Marketplace copies the template into your own Framer account.' },
  { n: 3, title: 'Make it yours and publish', text: 'Replace the text and images, adjust the style and put your site live.' },
];

const faq = [
  { q: 'How do I use a template?', a: 'Open a template from the catalog, press the remix button on its Framer Marketplace page and the template is copied to your Framer account, ready to edit.' },
  { q: 'Are the templates free?', a: 'Some are free and some are paid. The price is shown on every card.' },
  { q: 'Do I need to know how to code?', a: 'No. Everything is edited visually in Framer, including text, images and CMS content.' },
  { q: 'Will the templates work on mobile?', a: 'Yes. Every template is built to be responsive on phone, tablet and desktop.' },
];

const points = [
  { title: 'Responsive', text: 'Every template is built to look right on phone, tablet and desktop.' },
  { title: 'No code needed', text: 'Remix on Framer and edit text, images and CMS content visually.' },
  { title: 'Free and premium', text: 'Start with a free template or pick a premium one for a specific use case.' },
];
---

<Base overlayHeader>
  <section class="flex h-svh min-h-[36rem] flex-col items-center px-5 pt-36 text-center md:pt-32" aria-labelledby="hero-title">
    <p class="mb-5 text-sm text-accent">Framer templates by {site.name}</p>
    <h1 id="hero-title" class="max-w-3xl text-balance text-4xl font-semibold leading-[1.05] tracking-tight sm:text-6xl">
      Minimal Framer templates for modern websites.
    </h1>
    <p class="mt-6 max-w-xl text-pretty text-lg text-muted">
      Portfolios, agencies and weddings. Pick a template, remix it on Framer and make it yours.
    </p>
    <div class="mt-9 flex flex-wrap justify-center gap-3">
      <a href="/templates/" class="rounded-full bg-fg px-5 py-3 text-sm font-medium text-bg transition hover:bg-white/85">Browse all templates</a>
      <a href={site.framerProfile} target="_blank" rel="noopener noreferrer" class="rounded-full border border-line px-5 py-3 text-sm font-medium text-fg transition hover:border-white/30">Framer profile ↗</a>
    </div>
    <div class="relative mt-6 min-h-40 w-full flex-1">
      <Image
        src={heroMonitor}
        alt="A monitor on a wooden desk showing the Softic Studio template"
        widths={[640, 960, 1249]}
        sizes="(min-width: 1024px) 800px, 100vw"
        loading="eager"
        fetchpriority="high"
        class="hero-monitor absolute inset-0 h-full w-full object-contain object-bottom"
      />
    </div>
  </section>

  <section id="templates" class="mx-auto max-w-6xl px-5 pb-8" aria-labelledby="featured-title">
    <div class="mb-6 flex items-end justify-between gap-4">
      <h2 id="featured-title" class="text-2xl font-semibold tracking-tight">Featured templates</h2>
      <a href="/templates/" class="text-sm text-muted transition hover:text-fg">View all →</a>
    </div>
    <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {featured.map((t) => <TemplateCard template={t} />)}
    </ul>
    <div class="mt-10 flex justify-center">
      <a href="/templates/" class="rounded-full border border-line px-6 py-3 text-sm font-medium transition hover:border-white/30 hover:bg-surface">View all templates</a>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-24 text-center sm:py-32" aria-label="Tagline">
    <p class="mx-auto max-w-4xl text-balance text-4xl font-semibold leading-[1.1] tracking-tight sm:text-6xl">
      Pick it. <span class="text-muted">Remix it.</span><br />
      Make it yours. <span class="text-accent">Ship it.</span>
    </p>
  </section>

  <section id="how" class="mx-auto max-w-6xl px-5 pb-8" aria-labelledby="how-title">
    <h2 id="how-title" class="max-w-xl text-3xl font-semibold tracking-tight sm:text-4xl">Three steps to your new website</h2>
    <p class="mt-3 max-w-xl text-muted">From choosing a template to a live site, without writing code.</p>
    <ol class="mt-10 grid gap-5 sm:grid-cols-3">
      {steps.map((st) => (
        <li class="flex min-h-56 flex-col justify-between rounded-2xl border border-line bg-surface p-6">
          <span class="self-end text-5xl font-light italic text-muted">{st.n}</span>
          <div>
            <h3 class="text-xl font-medium">{st.title}</h3>
            <p class="mt-2 text-sm text-muted">{st.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section id="about" class="mx-auto max-w-6xl px-5 py-20" aria-labelledby="about-title">
    <h2 id="about-title" class="text-2xl font-semibold tracking-tight">Why these templates</h2>
    <p class="mt-3 max-w-2xl text-muted">
      Templates made by {site.name} with a focus on clean typography, calm layouts and smooth details.
    </p>
    <ul class="mt-10 grid gap-5 sm:grid-cols-3">
      {points.map((p) => (
        <li class="rounded-2xl border border-line bg-surface p-6">
          <h3 class="font-medium">{p.title}</h3>
          <p class="mt-2 text-sm text-muted">{p.text}</p>
        </li>
      ))}
    </ul>
  </section>
  <section id="faq" class="mx-auto max-w-3xl px-5 pb-20" aria-labelledby="faq-title">
    <h2 id="faq-title" class="text-2xl font-semibold tracking-tight">Questions</h2>
    <div class="mt-6 divide-y divide-line border-y border-line">
      {faq.map((f) => (
        <details class="group py-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-medium">
            {f.q}
            <span aria-hidden="true" class="text-muted transition group-open:rotate-45">+</span>
          </summary>
          <p class="mt-3 text-muted">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-24" aria-labelledby="cta-title">
    <div class="relative overflow-hidden rounded-3xl border border-line bg-surface px-8 py-14 sm:px-14 sm:py-20">
      <div aria-hidden="true" class="pointer-events-none absolute -right-24 -top-24 h-80 w-80 rounded-full bg-accent/25 blur-3xl"></div>
      <h2 id="cta-title" class="relative max-w-xl text-balance text-3xl font-semibold tracking-tight sm:text-5xl">Launch your website today</h2>
      <p class="relative mt-4 max-w-lg text-muted">Choose a template, remix it in Framer and have your site online in an afternoon.</p>
      <a href="/templates/" class="relative mt-8 inline-block rounded-full bg-fg px-6 py-3 text-sm font-medium text-bg transition hover:bg-white/85">Discover templates</a>
    </div>
  </section>
</Base>

<style>
  /* Fade the bottom edge of the desk into the page background. */
  .hero-monitor {
    mask-image: linear-gradient(to bottom, #000 80%, transparent);
  }
</style>
