---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import TemplateCard from '../components/TemplateCard.astro';

const templates = (await getCollection('templates')).sort(
  (a, b) => b.data.added.getTime() - a.data.added.getTime(),
);
const count = String(templates.length).padStart(2, '0');
---

<Base
  title="All Framer Templates"
  description="Browse the full catalog of Framer templates by Vonex Design. Free and premium, responsive and ready to customize. Open any template on Framer Marketplace to preview and remix it."
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'All Framer Templates',
    url: new URL('/templates/', Astro.site).href,
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: templates.map((t, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: `${t.data.name}: ${t.data.tagline}`,
        url: new URL(`/templates/${t.id}/`, Astro.site).href,
      })),
    },
  }}
>
  <Section labelledby="list-title">
    <SectionHeader
      id="list-title"
      level={1}
      kicker="Catalog"
      title="All templates."
      lead="Every Framer template by Vonex Design. Open one to see it live and remix it."
    >
      <p class="type-label">{count} templates · Newest first</p>
    </SectionHeader>
    <ul class="grid-4 gap-y-xl">
      {templates.map((t) => <TemplateCard template={t} class="col-span-4 md:col-span-2" />)}
    </ul>
  </Section>
</Base>
