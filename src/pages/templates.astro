---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import CatalogGrid from '../components/CatalogGrid.astro';

const templates = (await getCollection('templates')).sort(
  (a, b) => b.data.added.getTime() - a.data.added.getTime(),
);
// Mention premium templates only while the catalog has one.
const hasPaid = templates.some((t) => t.data.price > 0);
---

<Base
  title={hasPaid ? 'Website Templates for Framer and Code' : 'Free Website Templates for Framer and Astro'}
  image="/og/pages/templates.png"
  description={`Find a website template for your portfolio, agency, app, SaaS product or therapy practice. ${hasPaid ? 'Explore free and paid designs by Vonex' : 'Every Vonex template is free, some also come as Astro code'}, with screenshots and live demos.`}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'All website templates',
    url: new URL('/templates/', Astro.site).href,
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: templates.map((t, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: `${t.data.name}: ${t.data.tagline}`,
        url: new URL(`/templates/${t.id}/`, Astro.site).href,
      })),
    },
  }}
>
  <Section labelledby="list-title" flush="bottom" bar={{ left: 'Catalog', right: 'Newest first' }}>
    <SectionHeader
      id="list-title"
      level={1}
      title="Website templates."
      accent="templates"
    >
      <p class="type-body type-pillar">Find a starting point for your site, in Framer or as code. Open a template to compare its pages, features and live demo.</p>
    </SectionHeader>
    <CatalogGrid templates={templates} filters />
  </Section>
</Base>
