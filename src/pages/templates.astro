---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import TemplateCard from '../components/TemplateCard.astro';

const templates = (await getCollection('templates')).sort(
  (a, b) => b.data.added.getTime() - a.data.added.getTime(),
);
---

<Base
  title="All Framer Templates"
  description="Browse the full catalog of Framer templates by Vonex Design. Free and premium, responsive and ready to customize. Open any template on Framer Marketplace to preview and remix it."
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'All Framer Templates',
    url: new URL('/templates/', Astro.site).href,
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: templates.map((t, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: `${t.data.name}: ${t.data.tagline}`,
        url: new URL(`/templates/${t.id}/`, Astro.site).href,
      })),
    },
  }}
>
  <Section flush="bottom" class="pt-10 sm:pt-12">
    <SectionHeader
      level={1}
      title="All Framer templates"
      lead="Every Framer template by Vonex Design in one place. Open any template to preview it live and remix it into your own Framer project."
    />
  </Section>

  <Section labelledby="list-title" flush="top" class="pt-10">
    <h2 id="list-title" class="sr-only">Templates</h2>
    <ul class="grid-12 gap-y-10">
      {templates.map((t) => <TemplateCard template={t} class="col-span-12 sm:col-span-6 lg:col-span-4" />)}
    </ul>
  </Section>
</Base>
