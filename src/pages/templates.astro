---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import CatalogGrid from '../components/CatalogGrid.astro';
import Button from '../components/Button.astro';

const templates = (await getCollection('templates')).sort(
  (a, b) => b.data.added.getTime() - a.data.added.getTime(),
);
const count = String(templates.length).padStart(2, '0');
// Mention premium templates only while the catalog has one.
const hasPaid = templates.some((t) => t.data.price > 0);
---

<Base
  title={hasPaid ? 'Framer Templates — Free and Premium' : 'Free Framer Templates, Some Also as Code'}
  image="/og/pages/templates.png"
  description={`Find a Framer template for your portfolio, agency, app or SaaS product. ${hasPaid ? 'Explore free and paid designs by Vonex' : 'Every Vonex template is free, some also come as Astro code'}, with screenshots and live demos.`}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'All Framer Templates',
    url: new URL('/templates/', Astro.site).href,
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: templates.map((t, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: `${t.data.name}: ${t.data.tagline}`,
        url: new URL(`/templates/${t.id}/`, Astro.site).href,
      })),
    },
  }}
>
  <Section labelledby="list-title" flush="bottom" bar={{ left: 'Catalog', right: `${count} templates · Newest first` }}>
    <SectionHeader
      id="list-title"
      level={1}
      title="Framer templates."
      accent="templates"
      lead="Find a starting point for your portfolio, agency, app or software product. Open a template to compare its pages, CMS features and live demo."
    />
    <CatalogGrid templates={templates} />
  </Section>
</Base>
