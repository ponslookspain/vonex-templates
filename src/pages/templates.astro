---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import TemplateCard from '../components/TemplateCard.astro';

const templates = (await getCollection('templates')).sort(
  (a, b) => b.data.added.getTime() - a.data.added.getTime(),
);
---

<Base
  title="All Framer Templates"
  description="Browse every Framer template by Vonex Design: portfolio, agency and wedding websites. Free and premium, each one opens on Framer Marketplace so you can preview and remix it."
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'All Framer Templates',
    url: new URL('/templates/', Astro.site).href,
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: templates.map((t, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: `${t.data.name}: ${t.data.tagline}`,
        url: t.data.affiliateUrl ?? t.data.url,
      })),
    },
  }}
>
  <section class="mx-auto max-w-6xl px-5 pb-10 pt-16 text-center sm:pt-20">
    <h1 class="text-5xl font-bold sm:text-6xl">All Framer templates</h1>
    <p class="mx-auto mt-4 max-w-xl text-muted">
      Portfolio, agency and wedding templates for Framer. Open any template to preview it and remix it into your own project.
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-20" aria-label="Templates">
    <ul class="grid gap-x-5 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
      {templates.map((t) => <TemplateCard template={t} />)}
    </ul>
  </section>
</Base>
