---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import TemplateCard from '../../components/TemplateCard.astro';
import Button from '../../components/Button.astro';
import { buildContent } from '../../lib/template-content';

const templates = (await getCollection('templates'))
  .filter((template) => template.data.price === 0)
  .sort((a, b) => b.data.added.getTime() - a.data.added.getTime());
const count = String(templates.length).padStart(2, '0');
---

<Base
  title="Free Framer Templates for Portfolios, Agencies and Apps"
  image="/og/pages/free.png"
  description="Explore free Framer templates by Vonex Design. Compare portfolio, agency, app and SaaS websites, view the demos and choose a template to customize."
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Free Framer Templates',
    url: new URL('/templates/free/', Astro.site).href,
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: templates.map((template, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: `${template.data.name}: ${template.data.tagline}`,
        url: new URL(`/templates/${template.id}/`, Astro.site).href,
      })),
    },
  }}
>
  <Section labelledby="free-title" flush="bottom" bar={{ left: '01 / Free', right: `${count} free templates · Newest first` }}>
    <SectionHeader
      id="free-title"
      level={1}
      title="Free Framer templates."
      accent="Free"
      lead="Start with a complete website, then make it yours. These templates cost nothing to get from Framer Marketplace."
    />
    <ul class="card-grid flush-rails">
      {templates.map((template) => <TemplateCard template={template} level={2} />)}
    </ul>
  </Section>

  <Section labelledby="choose-title" bar={{ left: '02 / Compare', right: 'Type · Pages · CMS' }}>
    <SectionHeader
      id="choose-title"
      title="Compare at a glance."
      accent="glance"
      lead="Open a template for its full page list, screenshots and live demo."
    />
    <div class="overflow-x-auto">
      <table class="type-body w-full min-w-[32rem] border-collapse text-left">
        <thead>
          <tr class="type-label border-t border-line">
            <th class="py-md pr-md font-normal">Template</th>
            <th class="py-md pr-md font-normal">Type</th>
            <th class="py-md pr-md font-normal">Pages</th>
            <th class="py-md font-normal">CMS</th>
          </tr>
        </thead>
        <tbody>
          {templates.map((template) => {
            const content = buildContent(template.data);
            return (
              <tr class="border-t border-line">
                <th scope="row" class="py-md pr-md font-bold"><a href={`/templates/${template.id}/`} class="link">{template.data.name}</a></th>
                <td class="py-md pr-md">{template.data.pageKind ?? template.data.category}</td>
                <td class="py-md pr-md">{content.pages.length || '–'}</td>
                <td class="py-md">{content.hasCms ? 'Yes' : '–'}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </Section>

  <Section labelledby="publishing-title" bar={{ left: '03 / Publishing', right: 'What it costs' }}>
    <div class="grid-4 gap-y-xl">
      <h2 id="publishing-title" class="type-headline-md col-span-4 lg:col-span-2">Free template. Your publishing <em class="type-accent">plan</em>.</h2>
      <div class="col-span-4 lg:col-span-2">
        <p class="type-body type-prose">The template price covers the website project. Framer hosting, a custom domain and any paid services are separate. Choose a Framer site plan that supports the pages and CMS content you need.</p>
        <p class="type-body type-prose mt-lg">Check the live demo and included pages before you choose. Replace the example copy, images and links with your own, then check each layout before publishing.</p>
        <p class="type-body mt-lg"><a href="https://www.framer.com/pricing/" class="link" target="_blank" rel="noopener noreferrer">Check current Framer plans</a> · <a href="/guides/framer-pricing/" class="link">Is Framer free?</a> · <a href="/guides/how-to-use-framer-templates/" class="link">How to use a Framer template</a></p>
        <Button href="/templates/" variant="secondary" arrow class="mt-xl">Explore all templates</Button>
      </div>
    </div>
  </Section>
</Base>
