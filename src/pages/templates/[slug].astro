---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import Section from '../../components/Section.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import Button from '../../components/Button.astro';
import FaqItem from '../../components/FaqItem.astro';
import FaqBlock from '../../components/FaqBlock.astro';
import Icon from '../../components/Icon.astro';
import TemplateCard from '../../components/TemplateCard.astro';
import LivePreview from '../../components/LivePreview.astro';
import { site } from '../../data/site';
import { buildContent, buildFaq, richText, plainText } from '../../lib/template-content';
import { buyLink, buyLabel } from '../../lib/buy';
import { categoryHref, categoryPages } from '../../lib/categories';

export async function getStaticPaths() {
  const templates = await getCollection('templates');
  return templates.map((template) => ({ params: { slug: template.id }, props: { template, all: templates } }));
}

const { template, all } = Astro.props;
const t = template.data;
const editorial = t.overview ? t : undefined;
const c = buildContent(t);
const faq = buildFaq(t, c, { siteEmail: site.email });
// Two other templates, one row of the 2-up grid: the same category first, then the newest.
const shared = (x: typeof template) => x.data.types.filter((type) => t.types.includes(type)).length;
const ownCategory = categoryPages(all).find((c) => t.types.includes(c.slug));
const others = all
  .filter((x) => x.id !== template.id)
  .sort((a, b) => shared(b) - shared(a) || b.data.added.getTime() - a.data.added.getTime())
  .slice(0, 2);

const free = t.price === 0;
const priceLabel = free ? 'Free' : `$${t.price}`;
const buy = buyLink(t);
// Optional code version, sold on Contra (see docs/production/code-versions.md).
const codeUrl = t.codeUrl;
const framerLabel = buyLabel(t);
const codePriceLabel =t.codePrice === undefined ? '' : t.codePrice === 0 ? 'Free' : `$${t.codePrice}`;
const pageUrl = new URL(`/templates/${template.id}/`, Astro.site).href;
const ogPath = `/og/${template.id}.png`;
const pad = (n: number) => String(n).padStart(2, '0');

const gallery = t.gallery.length ? t.gallery : [{ type: 'image' as const, src: t.image, alt: `${t.name} Framer template` }];
// With a live demo its poster is the first picture, so the list below starts from the second.
const screens = t.preview ? gallery.slice(1) : gallery;
const updatedAt = t.updated ?? t.added;
const updatedLabel = updatedAt.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });

const stats = [
  c.pages.length ? { value: pad(c.pages.length), label: 'Pages' } : c.sectionNames.length ? { value: pad(c.sectionNames.length), label: 'Sections' } : null,
  { value: c.hasCms ? 'Yes' : 'No', label: 'CMS' },
  { value: codeUrl ? 'Framer, Astro' : 'Framer', label: 'Formats' },
  { value: updatedLabel, label: 'Updated' },
].filter((x): x is { value: string; label: string } => x !== null);

// Search results show about 160 characters.
const article = /^[aeiou]/i.test(t.category) ? 'an' : 'a';
const baseDescription = t.seoDescription ?? `${t.name} is ${article} ${t.category.toLowerCase()} Framer template by ${site.name}. ${t.description}`;
// The code note goes last but must survive the cut, so the base text is shortened to make room for it.
const codeNote = codeUrl ? ' Also as Astro code.' : '';
const room = 160 - codeNote.length;
const description = (baseDescription.length > room ? baseDescription.slice(0, room - 3).replace(/\s+\S*$/, '') + '…' : baseDescription) + codeNote;
const templateKind = t.pageKind ?? t.category;
// A code version is named in the title too: it is the only page that answers "Astro template" searches.
const title = `${t.name} — ${free ? 'Free ' : ''}Framer ${templateKind} Template${free ? '' : ` ($${t.price})`}${codeUrl ? ' + Astro Code' : ''}`;

// Short index beside the screens. Only the blocks people look for, so it stays one glance long.
const pageLinks = [
  ...c.blocks.filter((b) => b.kind === 'features' || b.kind === 'pages' || b.kind === 'sections').map((b) => ({ href: `#${b.id}`, label: b.title })),
  { href: '#formats', label: codeUrl ? 'Framer or code' : 'Publish' },
  { href: '#questions', label: 'Questions' },
];

// The imported intro often starts with a one-line headline, followed by the real text.
const leadHead = c.leadTitle ?? (c.lead.length > 1 && c.lead[0].length < 110 ? c.lead[0] : undefined);
const leadText = c.leadTitle ? c.lead : leadHead ? c.lead.slice(1) : c.lead;
---

<Base
  title={title}
  description={description}
  image={ogPath}
  jsonLd={{
    '@context': 'https://schema.org',
    '@graph': [
      {
        // The Framer template stays a CreativeWork: it is not sold here. Only the code version
        // has a price of ours, so it alone gets a Product below.
        '@type': 'CreativeWork',
        name: `${t.name}: ${t.tagline}`,
        description: t.description,
        image: new URL(ogPath, Astro.site).href,
        url: pageUrl,
        genre: `${t.category} Framer template`,
        isAccessibleForFree: t.price === 0,
        creator: { '@type': 'Organization', name: site.name, url: new URL('/', Astro.site).href },
        sameAs: t.url,
      },
      ...(codeUrl && t.codePrice !== undefined
        ? [
            {
              '@type': 'Product',
              name: `${t.name} Astro code`,
              description: `Hand-written Astro and Tailwind CSS code version of the ${t.name} template.`,
              image: new URL(ogPath, Astro.site).href,
              url: pageUrl,
              brand: { '@type': 'Brand', name: site.name },
              offers: {
                '@type': 'Offer',
                url: codeUrl,
                price: t.codePrice,
                priceCurrency: 'USD',
                availability: 'https://schema.org/InStock',
              },
            },
          ]
        : []),
      {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
          { '@type': 'ListItem', position: 2, name: 'Templates', item: new URL('/templates/', Astro.site).href },
          { '@type': 'ListItem', position: 3, name: t.name, item: pageUrl },
        ],
      },
      {
        '@type': 'FAQPage',
        mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: plainText(f.a) } })),
      },
    ],
  }}
>
  <Section class="section-with-bar" flush="bottom" label={`${t.name} template`}>
    <!-- The bar carries the breadcrumb, so the page starts on a line like every other page. -->
    <div class="section-bar type-label mb-0" data-reveal-skip>
      <nav aria-label="Breadcrumb">
        <a href="/" class="underline-offset-4 hover:underline">Home</a>
        <span aria-hidden="true" class="mx-2">/</span>
        <a href="/templates/" class="underline-offset-4 hover:underline">Templates</a>
        <span aria-hidden="true" class="mx-2">/</span>
        <span>{t.name}</span>
      </nav>
      <!-- Hidden on phones: no room next to the breadcrumb, and the kicker below says the same. -->
      <span class="hidden text-right sm:inline">{priceLabel} · {templateKind}</span>
    </div>

    <!-- A spec sheet on the page rails. First the decision: name and price with every action, then
         the facts. Below them the screens, with a buy column that stays in view on large screens,
         then the details as label + content rows. -->
    <div class="product flush-rails">
      <div class="p-top">
        <header class="p-head p-block">
          <p class="type-label">{free ? 'Free ' : ''}Framer {templateKind} template</p>
          <h1 class="type-headline-lg mt-lg break-words">{t.name}</h1>
          <p class="type-body type-pillar mt-lg">{t.tagline}</p>
        </header>
        {editorial ? (
          <div class="lead p-block p-about">
            <p class="type-label mb-sm">About</p>
            <h2 class="lead-head">{templateKind} template for Framer</h2>
            <p>{editorial.overview}</p>
          </div>
        ) : (leadHead || leadText.length > 0) && (
          <div class="lead p-block p-about">
            <p class="type-label mb-sm">About</p>
            {leadHead && <h2 class="lead-head">{leadHead}</h2>}
            {leadText.map((p) => <p set:html={richText(p)} />)}
          </div>
        )}
        <div class="buy p-block lg:hidden">
          <p class="type-label">Price</p>
          <p class="type-headline-md mt-sm">{priceLabel}</p>
          <div class="buy-actions">
            <Button href={buy.href} arrow target="_blank" rel={buy.sponsored ? 'noopener noreferrer sponsored' : 'noopener noreferrer'} data-umami-event="framer_click" data-umami-event-template={template.id} data-umami-event-placement="top">
              {framerLabel}
            </Button>
            {t.preview && <Button href="#live-preview" variant="secondary">Live preview</Button>}
            {codeUrl && (
              <Button href={codeUrl} variant="secondary" arrow target="_blank" rel="noopener noreferrer" data-umami-event="buy_code_click" data-umami-event-template={template.id} data-umami-event-placement="top">
                Buy code · {codePriceLabel}
              </Button>
            )}
          </div>
        </div>
      </div>

      <dl class="stats">
        {stats.map((s) => (
          <div class="stat">
            <dt class="stat-label">{s.label}</dt>
            <dd class="stat-value">{s.value}</dd>
          </div>
        ))}
      </dl>

      <div class="p-media">
        <div class="p-screens">
          {t.preview && <LivePreview url={t.preview} name={t.name} poster={t.image} />}
          {screens.map((item, i) => (
            <figure class="screen">
              <Image src={item.src} alt={item.alt} widths={[640, 960, 1400]} sizes="(min-width: 1024px) 75vw, 100vw" class="w-full" />
              <figcaption class="screen-caption type-label">Screen {pad(i + (t.preview ? 2 : 1))}</figcaption>
            </figure>
          ))}
        </div>
        <aside class="p-side" aria-label="Get this template">
          <div class="p-side-inner">
            <p class="type-label">{priceLabel}</p>
            <div class="side-actions">
              <Button href={buy.href} arrow target="_blank" rel={buy.sponsored ? 'noopener noreferrer sponsored' : 'noopener noreferrer'} data-umami-event="framer_click" data-umami-event-template={template.id} data-umami-event-placement="side">
              {framerLabel}
            </Button>
              {codeUrl && (
                <Button href={codeUrl} variant="secondary" arrow target="_blank" rel="noopener noreferrer" data-umami-event="buy_code_click" data-umami-event-template={template.id} data-umami-event-placement="side">
                Buy code · {codePriceLabel}
              </Button>
              )}
            </div>
            <nav class="side-nav type-label" aria-label="On this page">
              {pageLinks.map((l) => <a href={l.href}>{l.label}</a>)}
            </nav>
          </div>
        </aside>
      </div>

      <!-- Details: a label on the left, its content on the right. -->
      <div class="doc p-doc">
        {c.about.length > 0 && (
          <section class="doc-section p-block" aria-labelledby="about">
            <h2 class="kicker" id="about">About</h2>
            <div class="big-text">
              {c.about.map((p) => <p set:html={richText(p)} />)}
            </div>
          </section>
        )}

        {c.benefits.length > 0 && (
          <section class="doc-section p-block" aria-labelledby="benefits">
            <h2 class="kicker" id="benefits">{c.benefitsTitle}</h2>
            <ol class="benefits">
              {c.benefits.map((b, i) => (
                <li>
                  <span class="benefit-num" aria-hidden="true">{pad(i + 1)}</span>
                  <div>
                    <h3>{b.title}</h3>
                    <p set:html={richText(b.text)} />
                  </div>
                </li>
              ))}
            </ol>
          </section>
        )}

        {c.blocks.map((b) => (
          <section class="doc-section p-block" aria-labelledby={b.id}>
            <h2 class="kicker" id={b.id}>{b.title}</h2>
            {b.kind === 'text' && (
              <div class="body-text">
                {b.paragraphs.map((p) => <p set:html={richText(p)} />)}
              </div>
            )}
            {(b.kind === 'features' || b.kind === 'included' || b.kind === 'list') && (
              <ul class:list={['checks', b.kind === 'features' && 'checks-2']}>
                {b.items.map((item) => (
                  <li>
                    <Icon name="check" class="check" />
                    <span set:html={richText(item)} />
                  </li>
                ))}
              </ul>
            )}
            {(b.kind === 'pages' || b.kind === 'sections') && (
              <ol class="pages">
                {b.items.map((item, i) => (
                  <li>
                    <span class="pages-num" aria-hidden="true">{pad(i + 1)}</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ol>
            )}
            {b.kind === 'bestFor' && (
              <ul class="flex flex-wrap gap-2">
                {b.items.map((item) => <li class="tag">{item}</li>)}
              </ul>
            )}
          </section>
        ))}

        <!-- The formats side by side, then what publishing takes. -->
        <div class="formats" id="formats">
          <section class="format" aria-labelledby="framer-version">
            <h2 class="kicker" id="framer-version">Framer</h2>
            <p class="type-label">{priceLabel}</p>
            <div class="body-text">
              <p>Edit the template visually, with no code, and publish it from Framer.</p>
            </div>
          </section>
          {codeUrl && (
            <section class="format" aria-labelledby="code-version">
              <h2 class="kicker" id="code-version">Astro code</h2>
              <p class="type-label">{codePriceLabel}</p>
              <div class="body-text">
                <p>
                  Prefer not to use Framer? {t.name} also comes as a clean Astro and Tailwind CSS project: the same design,
                  on phone, tablet and desktop, as code you own and host anywhere. It closely follows the Framer design. The
                  README lists the few known differences.
                </p>
              </div>
              <ul class="checks mt-lg">
                <li><Icon name="check" class="check" /><span>Every text, link and price in one file, so you edit content without touching the layout</span></li>
                <li><Icon name="check" class="check" /><span>Static build: no framework runtime, deploys to Cloudflare, Netlify, Vercel or your own server</span></li>
                <li><Icon name="check" class="check" /><span>README with setup and deploy steps, license and changelog included</span></li>
              </ul>
              <div class="buy-actions">
                <Button href={codeUrl} arrow target="_blank" rel="noopener noreferrer" data-umami-event="buy_code_click" data-umami-event-template={template.id} data-umami-event-placement="code-section">
                  Buy code · {codePriceLabel}
                </Button>
                <Button href="/license/" variant="secondary">Read the license</Button>
              </div>
            </section>
          )}
          <section class="format" aria-labelledby="before-you-publish">
            <h2 class="kicker" id="before-you-publish">Before you publish</h2>
            <div class="body-text">
              {t.preparation && <p>{t.preparation}</p>}
              <p>
                The free Framer plan publishes on a framer.website address. Your own domain needs a paid site plan, from
                Basic: <a href={site.framerReferral} class="link" target="_blank" rel="noopener noreferrer sponsored">see Framer plans</a>,
                or compare them in <a href="/guides/framer-pricing/" class="link">Framer pricing explained</a>.
              </p>
              <p>
                Step by step, with costs: <a href="/guides/how-to-use-framer-templates/" class="link">how to use a Framer template</a>.
                Questions about this template? <a href={`mailto:${site.email}`} class="link">Write to the author</a>.
              </p>
            </div>
          </section>
        </div>

        {(t.framerFeatures.length > 0 || t.styles.length > 0) && (
          <section class="doc-section p-block" aria-labelledby="built-with">
            <h2 class="kicker" id="built-with">Built with Framer</h2>
            {t.framerFeatures.length > 0 && (
              <ul class="flex flex-wrap gap-2">
                {t.framerFeatures.map((f) => <li class="tag tag-solid">{f}</li>)}
              </ul>
            )}
            {t.styles.length > 0 && (
              <>
                <p class="mini-label">Style</p>
                <ul class="flex flex-wrap gap-2">
                  {t.styles.map((s) => <li class="tag">{s}</li>)}
                </ul>
              </>
            )}
          </section>
        )}

        {c.updates.length > 0 && (
          <section class="doc-section p-block" aria-labelledby="updates">
            <h2 class="kicker" id="updates">Updates</h2>
            <ol class="timeline">
              {c.updates.map((u) => (
                <li>
                  <h3>{u.title}</h3>
                  <ul>
                    {u.items.map((item) => <li set:html={richText(item)} />)}
                  </ul>
                </li>
              ))}
            </ol>
          </section>
        )}

        {c.support && (
          <section class="doc-section p-block" aria-labelledby="support">
            <h2 class="kicker" id="support">Support</h2>
            <p class="body-text support" set:html={richText(c.support)} />
          </section>
        )}

        {c.policy && (
          <section class="doc-section p-block" aria-labelledby="policy">
            <h2 class="kicker" id="policy">{c.policy.title}</h2>
            <p class="body-text support" set:html={richText(c.policy.text)} />
          </section>
        )}
      </div>
    </div>
  </Section>

  <div id="questions" class="scroll-mt-(--space-header)"></div>
  <FaqBlock title="Questions." accent="Questions" bar={{ left: 'FAQ', right: `${String(faq.length).padStart(2, '0')} answers` }}>
    {faq.map((f) => <FaqItem question={f.q}><Fragment set:html={richText(f.a)} /></FaqItem>)}
  </FaqBlock>

  <!-- Closing band: the one large black block of the page, on light rails. -->
  <CtaBand labelledby="get-title">
    <span class="type-label mb-lg block">{priceLabel} on {buy.shop}</span>
    <h2 id="get-title" class="type-headline-lg"><em class="type-accent">Get</em> {t.name}.</h2>
    <div class="buy-actions">
      <Button href={buy.href} variant="secondary" arrow target="_blank" rel={buy.sponsored ? 'noopener noreferrer sponsored' : 'noopener noreferrer'} data-umami-event="framer_click" data-umami-event-template={template.id} data-umami-event-placement="closing">
        {framerLabel}
      </Button>
      {codeUrl && (
        <Button href={codeUrl} variant="secondary" arrow target="_blank" rel="noopener noreferrer" data-umami-event="buy_code_click" data-umami-event-template={template.id} data-umami-event-placement="closing">
          Buy code · {codePriceLabel}
        </Button>
      )}
    </div>
    <div slot="media" class="border-(length:--border-frame) border-on-primary">
      <Image src={t.image} alt={`${t.name} Framer template: ${t.tagline}`} widths={[640, 960, 1400]} sizes="(min-width: 1024px) 50vw, 100vw" class="aspect-[4/3] w-full object-cover" />
    </div>
  </CtaBand>

  {others.length > 0 && (
    <Section labelledby="more-title" flush="bottom" bar={{ left: 'Catalog', right: `${String(others.length).padStart(2, '0')} more` }}>
      <SectionHeader id="more-title" title="More templates." accent="More">
        <Button href={ownCategory ? categoryHref(ownCategory.slug) : '/templates/'} variant="secondary" arrow>{ownCategory ? `${ownCategory.label} templates` : 'View all'}</Button>
      </SectionHeader>
      <ul class="card-grid flush-rails">
        {others.map((o) => <TemplateCard template={o} />)}
      </ul>
    </Section>
  )}
  <!-- Phones and tablets: the price and main action stay on screen. -->
  <div class="mobile-buy" data-reveal-skip>
    <span class="type-label">{priceLabel}</span>
    <Button href={buy.href} arrow target="_blank" rel={buy.sponsored ? 'noopener noreferrer sponsored' : 'noopener noreferrer'} data-umami-event="framer_click" data-umami-event-template={template.id} data-umami-event-placement="mobile-bar">
              {framerLabel}
            </Button>
  </div>
</Base>

<style>
  /* The page reads like a spec sheet: numbered sections, hairlines instead of boxes, labels in
     capitals. Imported Marketplace text is long, so it uses the prose measure, not the pillar. */
  .doc {
    min-width: 0;
  }

  /* Product on the rails. Phones: one column. From 1024px: name | price, the facts in one row,
     screens | buy column, and label + content rows for the details. */
  .product {
    /* Same place as the page rails: keeps them visible past the opaque stat cells. */
    border-inline: var(--border-hairline) solid var(--color-line);
  }
  /* One block: generous padding, a line above it from edge to edge. */
  .p-block {
    padding: var(--spacing-xl) var(--rail-inset);
    border-top: var(--border-hairline) solid var(--color-line);
  }
  .p-head {
    border-top: 0;
  }
  .p-doc > :first-child {
    border-top: 0;
  }
  .p-media {
    border-block: var(--border-hairline) solid var(--color-line);
  }
  .p-screens {
    min-width: 0;
  }
  .screen {
    border-top: var(--border-hairline) solid var(--color-line);
  }
  .p-screens > :first-child {
    border-top: 0;
  }
  .screen-caption {
    padding: var(--spacing-sm) var(--rail-inset);
    border-top: var(--border-hairline) solid var(--color-line);
    color: var(--color-muted);
  }
  .p-side {
    display: none;
  }
  .side-actions {
    display: grid;
    gap: var(--spacing-sm);
    margin-top: var(--spacing-md);
  }
  .side-nav {
    display: grid;
    margin-top: var(--spacing-xl);
    border-top: var(--border-hairline) solid var(--color-line);
  }
  .side-nav a {
    padding: var(--spacing-sm) 0;
    border-bottom: var(--border-hairline) solid var(--color-line);
  }
  .side-nav a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .p-doc [id] {
    scroll-margin-top: var(--space-header);
  }
  .formats {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--border-hairline);
    background: var(--color-line);
    border-top: var(--border-hairline) solid var(--color-line);
  }
  .format {
    padding: var(--spacing-xl) var(--rail-inset);
    background: var(--color-surface);
  }
  .format .kicker {
    margin-bottom: var(--spacing-sm);
  }
  .mobile-buy {
    position: sticky;
    bottom: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-md);
    padding: var(--spacing-sm) var(--space-page);
    background: var(--color-bg);
    border-top: var(--border-hairline) solid var(--color-line-strong);
  }
  @media (min-width: 64rem) {
    .p-top {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .p-about {
      display: block;
      border-top: 0;
      border-left: var(--border-hairline) solid var(--color-line);
    }
    .p-media {
      display: grid;
      grid-template-columns: minmax(0, 3fr) minmax(0, 1fr);
    }
    .p-side {
      display: block;
      padding: var(--spacing-lg);
      border-left: var(--border-hairline) solid var(--color-line);
    }
    .p-side-inner {
      position: sticky;
      top: calc(var(--space-header) + var(--spacing-lg));
    }
    .doc-section {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
      column-gap: var(--grid-gutter);
    }
    .doc-section > * {
      grid-column: 2;
    }
    .doc-section > .kicker {
      grid-column: 1;
      grid-row: 1 / span 6;
