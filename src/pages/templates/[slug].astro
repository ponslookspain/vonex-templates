---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Container from '../../components/Container.astro';
import Section from '../../components/Section.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import Button from '../../components/Button.astro';
import FaqItem from '../../components/FaqItem.astro';
import FaqBlock from '../../components/FaqBlock.astro';
import Icon from '../../components/Icon.astro';
import TemplateCard from '../../components/TemplateCard.astro';
import TemplateGallery from '../../components/TemplateGallery.astro';
import { site } from '../../data/site';
import { buildContent, buildFaq, richText, plainText } from '../../lib/template-content';

export async function getStaticPaths() {
  const templates = await getCollection('templates');
  return templates.map((template) => ({ params: { slug: template.id }, props: { template, all: templates } }));
}

const { template, all } = Astro.props;
const t = template.data;
const c = buildContent(t);
const faq = buildFaq(t, c, { siteEmail: site.email });
// The two newest other templates, one row of the 2-up grid.
const others = all
  .filter((x) => x.id !== template.id)
  .sort((a, b) => b.data.added.getTime() - a.data.added.getTime())
  .slice(0, 2);

const free = t.price === 0;
const priceLabel = free ? 'Free' : `$${t.price}`;
const buyUrl = t.affiliateUrl ?? t.url;
const pageUrl = new URL(`/templates/${template.id}/`, Astro.site).href;
const ogPath = `/og/${template.id}.png`;
const pad = (n: number) => String(n).padStart(2, '0');

const gallery = t.gallery.length ? t.gallery : [{ type: 'image' as const, src: t.image, alt: `${t.name} Framer template` }];
const updatedAt = t.updated ?? t.added;
const updatedLabel = updatedAt.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });

const stats = [
  c.pages.length ? { value: pad(c.pages.length), label: 'Pages' } : c.sectionNames.length ? { value: pad(c.sectionNames.length), label: 'Sections' } : null,
  { value: c.hasCms ? 'Yes' : 'No', label: 'CMS' },
  t.framerFeatures.length ? { value: pad(t.framerFeatures.length), label: 'Framer features' } : null,
  { value: updatedLabel, label: 'Updated' },
].filter((x): x is { value: string; label: string } => x !== null);

// Search results show about 160 characters.
const article = /^[aeiou]/i.test(t.category) ? 'an' : 'a';
const fullDescription = `${t.name} is ${article} ${t.category.toLowerCase()} Framer template by ${site.name}. ${t.description}`;
const description = fullDescription.length > 160 ? fullDescription.slice(0, 157).replace(/\s+\S*$/, '') + '…' : fullDescription;

// The imported intro often starts with a one-line headline, followed by the real text.
const leadHead = c.leadTitle ?? (c.lead.length > 1 && c.lead[0].length < 110 ? c.lead[0] : undefined);
const leadText = c.leadTitle ? c.lead : leadHead ? c.lead.slice(1) : c.lead;
---

<Base
  title={`${t.name} Framer Template`}
  description={description}
  image={ogPath}
  jsonLd={{
    '@context': 'https://schema.org',
    '@graph': [
      {
        // CreativeWork, not Product: the site sells nothing itself, so Google should not
        // treat template pages as merchant listings (no offers, ratings or shipping).
        '@type': 'CreativeWork',
        name: `${t.name}: ${t.tagline}`,
        description: t.description,
        image: new URL(ogPath, Astro.site).href,
        url: pageUrl,
        genre: `${t.category} Framer template`,
        isAccessibleForFree: t.price === 0,
        creator: { '@type': 'Organization', name: site.name, url: new URL('/', Astro.site).href },
        sameAs: t.url,
      },
      {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
          { '@type': 'ListItem', position: 2, name: 'Templates', item: new URL('/templates/', Astro.site).href },
          { '@type': 'ListItem', position: 3, name: t.name, item: pageUrl },
        ],
      },
      {
        '@type': 'FAQPage',
        mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: plainText(f.a) } })),
      },
    ],
  }}
>
  <Section flush="bottom" class="pt-10 sm:pt-12" label={`${t.name} template`}>
    <nav aria-label="Breadcrumb" class="type-label mb-xl">
      <a href="/" class="underline-offset-4 hover:underline">Home</a>
      <span aria-hidden="true" class="mx-2">/</span>
      <a href="/templates/" class="underline-offset-4 hover:underline">Templates</a>
      <span aria-hidden="true" class="mx-2">/</span>
      <span>{t.name}</span>
    </nav>

    <!-- On phones the name, price and Framer button come first, then the gallery, then the text.
         From 1024px the gallery stays in view on the left while the right column scrolls. -->
    <div class="grid-4 gap-y-xl lg:gap-y-0">
      <header class="col-span-4 lg:col-span-2 lg:col-start-3 lg:row-start-1">
        <p class="type-label">{t.category} Framer template</p>
        <h1 class="type-headline-lg mt-lg break-words">{t.name}</h1>
        <p class="type-body type-pillar mt-lg">{t.tagline}</p>

        <div class="buy">
          <p class="type-label">Price</p>
          <p class="type-headline-md mt-sm">{priceLabel}</p>
          <div class="buy-actions">
            <Button href={buyUrl} arrow target="_blank" rel={t.affiliateUrl ? 'noopener noreferrer sponsored' : 'noopener noreferrer'}>
              View on Framer
            </Button>
            {t.preview && (
              <Button href={t.preview} variant="secondary" target="_blank" rel="noopener noreferrer">
                View live
              </Button>
            )}
          </div>
        </div>
      </header>

      <div class="col-span-4 lg:sticky lg:top-[calc(var(--space-header)+var(--spacing-lg))] lg:col-span-2 lg:col-start-1 lg:row-span-2 lg:row-start-1 lg:self-start">
        <TemplateGallery items={gallery} name={t.name} />
      </div>

      <!-- Right: everything about the template. -->
      <div class="doc col-span-4 lg:col-span-2 lg:col-start-3 lg:row-start-2">
        <dl class="stats">
          {stats.map((s) => (
            <div class="stat">
              <dt class="stat-label">{s.label}</dt>
              <dd class="stat-value">{s.value}</dd>
            </div>
          ))}
        </dl>

        {(leadHead || leadText.length > 0) && (
          <div class="lead">
            {leadHead && <h2 class="lead-head">{leadHead}</h2>}
            {leadText.map((p) => <p set:html={richText(p)} />)}
          </div>
        )}

        {c.about.length > 0 && (
          <section class="doc-section" aria-labelledby="about">
            <h2 class="kicker" id="about">About</h2>
            <div class="big-text">
              {c.about.map((p) => <p set:html={richText(p)} />)}
            </div>
          </section>
        )}

        {c.benefits.length > 0 && (
          <section class="doc-section" aria-labelledby="benefits">
            <h2 class="kicker" id="benefits">{c.benefitsTitle}</h2>
            <ol class="benefits">
              {c.benefits.map((b, i) => (
                <li>
                  <span class="benefit-num" aria-hidden="true">{pad(i + 1)}</span>
                  <div>
                    <h3>{b.title}</h3>
                    <p set:html={richText(b.text)} />
                  </div>
                </li>
              ))}
            </ol>
          </section>
        )}

        {c.blocks.map((b) => (
          <section class="doc-section" aria-labelledby={b.id}>
            <h2 class="kicker" id={b.id}>{b.title}</h2>
            {b.kind === 'text' && (
              <div class="body-text">
                {b.paragraphs.map((p) => <p set:html={richText(p)} />)}
              </div>
            )}
            {(b.kind === 'features' || b.kind === 'included' || b.kind === 'list') && (
              <ul class:list={['checks', b.kind === 'features' && 'checks-2']}>
                {b.items.map((item) => (
                  <li>
                    <Icon name="check" class="check" />
                    <span set:html={richText(item)} />
                  </li>
                ))}
              </ul>
            )}
            {(b.kind === 'pages' || b.kind === 'sections') && (
              <ol class="pages">
                {b.items.map((item, i) => (
                  <li>
                    <span class="pages-num" aria-hidden="true">{pad(i + 1)}</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ol>
            )}
            {b.kind === 'bestFor' && (
              <ul class="flex flex-wrap gap-2">
                {b.items.map((item) => <li class="tag">{item}</li>)}
              </ul>
            )}
          </section>
        ))}

        {(t.framerFeatures.length > 0 || t.styles.length > 0) && (
          <section class="doc-section" aria-labelledby="built-with">
            <h2 class="kicker" id="built-with">Built with Framer</h2>
            {t.framerFeatures.length > 0 && (
              <ul class="flex flex-wrap gap-2">
                {t.framerFeatures.map((f) => <li class="tag tag-solid">{f}</li>)}
              </ul>
            )}
            {t.styles.length > 0 && (
              <>
                <p class="mini-label">Style</p>
                <ul class="flex flex-wrap gap-2">
                  {t.styles.map((s) => <li class="tag">{s}</li>)}
                </ul>
              </>
            )}
          </section>
        )}

        {c.updates.length > 0 && (
          <section class="doc-section" aria-labelledby="updates">
            <h2 class="kicker" id="updates">Updates</h2>
            <ol class="timeline">
              {c.updates.map((u) => (
                <li>
                  <h3>{u.title}</h3>
                  <ul>
                    {u.items.map((item) => <li set:html={richText(item)} />)}
                  </ul>
                </li>
              ))}
            </ol>
          </section>
        )}

        {c.support && (
          <section class="doc-section" aria-labelledby="support">
            <h2 class="kicker" id="support">Support</h2>
            <p class="body-text support" set:html={richText(c.support)} />
          </section>
        )}

        {c.policy && (
          <section class="doc-section" aria-labelledby="policy">
            <h2 class="kicker" id="policy">{c.policy.title}</h2>
            <p class="body-text support" set:html={richText(c.policy.text)} />
          </section>
        )}
      </div>
    </div>
  </Section>

  <FaqBlock title="Questions." rule>
    {faq.map((f) => <FaqItem question={f.q}><Fragment set:html={richText(f.a)} /></FaqItem>)}
  </FaqBlock>

  <!-- Closing band: the one large black block of the page. -->
  <section class="bg-primary text-on-primary" aria-labelledby="get-title">
    <Container class="grid-4 items-end gap-y-xl py-2xl">
      <div class="col-span-4 lg:col-span-2">
        <span class="kicker type-label">{priceLabel} on Framer Marketplace</span>
        <h2 id="get-title" class="type-headline-lg">Get {t.name}.</h2>
        <div class="buy-actions">
          <Button href={buyUrl} variant="secondary" arrow target="_blank" rel={t.affiliateUrl ? 'noopener noreferrer sponsored' : 'noopener noreferrer'}>
            View on Framer
          </Button>
        </div>
      </div>
      <div class="col-span-4 border-(length:--border-frame) border-on-primary lg:col-span-2">
        <Image src={t.image} alt="" widths={[640, 960, 1400]} sizes="(min-width: 1024px) 50vw, 100vw" class="aspect-[4/3] w-full object-cover" />
      </div>
    </Container>
  </section>

  {others.length > 0 && (
    <Section labelledby="more-title">
      <SectionHeader id="more-title" kicker="Catalog" title="More templates.">
        <Button href="/templates/" variant="secondary" arrow>View all</Button>
      </SectionHeader>
      <ul class="grid-4 gap-y-xl">
        {others.map((o) => <TemplateCard template={o} class="col-span-4 md:col-span-2" />)}
      </ul>
    </Section>
  )}
</Base>

<style>
  /* The page reads like a spec sheet: numbered sections, hairlines instead of boxes, labels in
     capitals. Imported Marketplace text is long, so it uses the prose measure, not the pillar. */
  .doc {
    min-width: 0;
  }

  /* header */
  .buy {
    margin-top: var(--spacing-xl);
    padding-top: var(--spacing-lg);
    border-top: var(--border-hairline) solid var(--color-line);
  }
  .buy-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
    margin-top: var(--spacing-lg);
  }

  /* numbers: cells sharing one hairline */
  .stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--border-hairline);
    margin-top: var(--spacing-xl);
    background: var(--color-line);
    border: var(--border-hairline) solid var(--color-line);
  }
  .stat {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--spacing-xl);
    padding: var(--space-card);
    background: var(--color-surface);
  }
  .stat-label {
    font-size: var(--text-label);
    line-height: var(--leading-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }
  .stat-value {
    font-size: var(--text-headline-sm);
    line-height: var(--leading-headline);
    font-weight: 700;
    letter-spacing: var(--tracking-headline);
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* text blocks */
  .lead {
    margin-top: var(--spacing-xl);
  }
  .lead-head,
  .kicker {
    font-size: var(--text-headline-sm);
    line-height: var(--leading-headline);
    font-weight: 700;
    letter-spacing: var(--tracking-headline);
    text-transform: uppercase;
  }
  .kicker {
    margin-bottom: var(--spacing-lg);
  }
  .lead p,
  .body-text p,
  .big-text p {
    max-width: var(--container-prose);
    margin-top: var(--spacing-md);
    line-height: 1.25;
  }
  .doc-section {
    margin-top: var(--spacing-xl);
    padding-top: var(--spacing-lg);
    border-top: var(--border-hairline) solid var(--color-line);
  }
  .big-text p:first-child {
    margin-top: 0;
    font-size: var(--text-headline-xs);
    line-height: 1.1;
    letter-spacing: var(--tracking-body);
  }
  /* Links inside the imported text (not buttons). */
  .doc :global(a:not(.btn)) {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .doc :global(a:not(.btn):hover) {
    text-decoration-thickness: 2px;
  }

  /* numbered benefits */
  .benefits li {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: var(--spacing-xs);
    padding: var(--spacing-lg) 0;
    border-top: var(--border-hairline) solid var(--color-line);
  }
  .benefits li:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .benefit-num {
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    font-variant-numeric: tabular-nums;
  }
  .benefits h3,
  .timeline h3 {
    font-size: var(--text-headline-xxs);
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: var(--tracking-headline);
    text-transform: uppercase;
  }
  .benefits p {
    margin-top: var(--spacing-xs);
    line-height: 1.25;
  }

  /* check lists */
  .checks {
    display: grid;
    gap: var(--spacing-md) var(--grid-gutter);
  }
  @media (min-width: 48rem) {
    .checks-2 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .checks li {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-sm);
    line-height: 1.25;
  }
  /* The icon is drawn by the Icon component, so the page's scoped styles need :global here. */
  .checks :global(.check) {
    flex: none;
    width: 1.125rem;
    height: 1.125rem;
  }

  /* pages */
  .pages {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--grid-gutter);
    border-top: var(--border-hairline) solid var(--color-line);
  }
  .pages li {
    display: flex;
    gap: var(--spacing-md);
    padding: var(--spacing-sm) 0;
    border-bottom: var(--border-hairline) solid var(--color-line);
    font-size: var(--text-label);
    line-height: var(--leading-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }
  .pages-num {
    font-variant-numeric: tabular-nums;
  }

  .mini-label {
    margin: var(--spacing-lg) 0 var(--spacing-sm);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  /* updates: a vertical hairline with square marks */
  .timeline {
    margin-left: 4px;
    padding-left: var(--spacing-lg);
    border-left: var(--border-hairline) solid var(--color-line);
  }
  .timeline > li {
    position: relative;
  }
  .timeline > li + li {
    margin-top: var(--spacing-lg);
  }
  .timeline > li::before {
    content: '';
    position: absolute;
    left: calc(-1 * var(--spacing-lg) - 4.5px);
    top: 2px;
    width: 8px;
    height: 8px;
    background: var(--color-primary);
  }
  .timeline ul {
    margin-top: var(--spacing-sm);
    display: grid;
    gap: var(--spacing-xs);
  }
  .timeline ul li {
    line-height: 1.25;
  }
  .support {
    margin-top: 0;
  }
</style>
