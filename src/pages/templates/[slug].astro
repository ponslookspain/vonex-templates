---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import Button from '../../components/Button.astro';
import TemplateCard from '../../components/TemplateCard.astro';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const templates = await getCollection('templates');
  return templates.map((template) => ({ params: { slug: template.id }, props: { template, all: templates } }));
}

const { template, all } = Astro.props;
const t = template.data;
const others = all.filter((x) => x.id !== template.id).sort((a, b) => b.data.added.getTime() - a.data.added.getTime());

const free = t.price === 0;
const priceLabel = free ? 'Free' : `$${t.price}`;
const buyUrl = t.affiliateUrl ?? t.url;
const pageUrl = new URL(`/templates/${template.id}/`, Astro.site).href;
const ogPath = `/og/${template.id}.png`;
const added = t.added.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });

// Search results show about 160 characters.
const article = /^[aeiou]/i.test(t.category) ? 'an' : 'a';
const fullDescription = `${t.name} is ${article} ${t.category.toLowerCase()} Framer template by ${site.name}. ${t.description}`;
const description = fullDescription.length > 160 ? fullDescription.slice(0, 157).replace(/\s+\S*$/, '') + '…' : fullDescription;

const facts = [
  { label: 'Category', value: t.category },
  { label: 'Price', value: priceLabel },
  { label: 'Platform', value: 'Framer' },
  { label: 'Added', value: added },
];
---

<Base
  title={`${t.name} Framer Template`}
  description={description}
  image={ogPath}
  jsonLd={{
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Product',
        name: `${t.name}: ${t.tagline}`,
        description: t.description,
        image: new URL(ogPath, Astro.site).href,
        url: pageUrl,
        category: `${t.category} Framer template`,
        brand: { '@type': 'Brand', name: site.name },
        offers: {
          '@type': 'Offer',
          price: t.price,
          priceCurrency: 'USD',
          availability: 'https://schema.org/InStock',
          url: buyUrl,
        },
      },
      {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
          { '@type': 'ListItem', position: 2, name: 'Templates', item: new URL('/templates/', Astro.site).href },
          { '@type': 'ListItem', position: 3, name: t.name, item: pageUrl },
        ],
      },
    ],
  }}
>
  <Section flush="bottom" class="pt-10 sm:pt-12" label={`${t.name} template`}>
    <nav aria-label="Breadcrumb" class="type-small mb-6 text-muted">
      <a href="/templates/" class="transition-colors duration-fast hover:text-fg">Templates</a>
      <span aria-hidden="true" class="mx-2">/</span>
      <span class="text-fg-soft">{t.name}</span>
    </nav>

    <div class="grid-12 gap-y-10">
      <div class="col-span-12 lg:col-span-7">
        <div class="panel p-3">
          <div class="relative aspect-[4/3] overflow-hidden rounded-surface bg-surface-2">
            <Image
              src={t.image}
              alt={`${t.name} Framer template: ${t.tagline}`}
              widths={[640, 1000, 1200]}
              sizes="(min-width: 1024px) 640px, 100vw"
              loading="eager"
              fetchpriority="high"
              class="h-full w-full object-cover"
            />
          </div>
        </div>
      </div>

      <div class="col-span-12 flex flex-col lg:col-span-5">
        <span class="eyebrow">{t.category} Framer template</span>
        <h1 class="type-h1 text-balance">{t.name}</h1>
        <p class="type-lead mt-4">{t.tagline}</p>

        <p class:list={['type-h2 mt-8', free && 'text-accent']}>{priceLabel}</p>
        <p class="type-body mt-4 text-fg-soft">{t.description}</p>

        {t.tags.length > 0 && (
          <ul class="mt-5 flex flex-wrap gap-2">
            {t.tags.map((tag) => <li class="tag">{tag}</li>)}
          </ul>
        )}

        <div class="mt-8 flex flex-wrap gap-3">
          <Button href={buyUrl} target="_blank" rel={t.affiliateUrl ? 'noopener noreferrer sponsored' : 'noopener noreferrer'}>
            Open on Framer
          </Button>
          {t.preview && (
            <Button href={t.preview} variant="ghost" target="_blank" rel="noopener noreferrer">
              Live preview
            </Button>
          )}
        </div>
        <p class="type-caption mt-3 text-muted">Opens Framer Marketplace in a new tab. Remix the template into your own Framer project.</p>

        <dl class="mt-10 grid grid-cols-2 gap-x-5 gap-y-4 border-t border-line pt-6">
          {facts.map((f) => (
            <div>
              <dt class="type-caption text-muted">{f.label}</dt>
              <dd class="type-small mt-1 text-fg">{f.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </Section>

  {others.length > 0 && (
    <Section labelledby="more-title">
      <SectionHeader id="more-title" title="More Framer templates" lead="Other templates by Vonex Design." />
      <ul class="grid-12 mt-12 gap-y-10">
        {others.map((o, i) => (
          <TemplateCard
            template={o}
            class:list={['col-span-12 sm:col-span-6 lg:col-span-4', others.length === 2 && i === 0 && 'lg:col-start-3']}
          />
        ))}
      </ul>
    </Section>
  )}
</Base>
