---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import Section from '../../components/Section.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import Button from '../../components/Button.astro';
import FaqItem from '../../components/FaqItem.astro';
import FaqBlock from '../../components/FaqBlock.astro';
import Icon from '../../components/Icon.astro';
import TemplateCard from '../../components/TemplateCard.astro';
import TemplateGallery from '../../components/TemplateGallery.astro';
import { site } from '../../data/site';
import { buildContent, buildFaq, richText, plainText } from '../../lib/template-content';
import { buyLink, buyLabel } from '../../lib/buy';

export async function getStaticPaths() {
  const templates = await getCollection('templates');
  return templates.map((template) => ({ params: { slug: template.id }, props: { template, all: templates } }));
}

const { template, all } = Astro.props;
const t = template.data;
const editorial = t.overview ? t : undefined;
const c = buildContent(t);
const faq = buildFaq(t, c, { siteEmail: site.email });
// The two newest other templates, one row of the 2-up grid.
const others = all
  .filter((x) => x.id !== template.id)
  .sort((a, b) => b.data.added.getTime() - a.data.added.getTime())
  .slice(0, 2);

const free = t.price === 0;
const priceLabel = free ? 'Free' : `$${t.price}`;
const buy = buyLink(t);
// Optional code version, sold on Contra (see CODE_TEMPLATES.md).
const codeUrl = t.codeUrl;
const framerLabel = buyLabel(t);
const codePriceLabel =t.codePrice === undefined ? '' : t.codePrice === 0 ? 'Free' : `$${t.codePrice}`;
const pageUrl = new URL(`/templates/${template.id}/`, Astro.site).href;
const ogPath = `/og/${template.id}.png`;
const pad = (n: number) => String(n).padStart(2, '0');

const gallery = t.gallery.length ? t.gallery : [{ type: 'image' as const, src: t.image, alt: `${t.name} Framer template` }];
const updatedAt = t.updated ?? t.added;
const updatedLabel = updatedAt.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });

const stats = [
  c.pages.length ? { value: pad(c.pages.length), label: 'Pages' } : c.sectionNames.length ? { value: pad(c.sectionNames.length), label: 'Sections' } : null,
  { value: c.hasCms ? 'Yes' : 'No', label: 'CMS' },
  t.framerFeatures.length ? { value: pad(t.framerFeatures.length), label: 'Framer features' } : null,
  { value: updatedLabel, label: 'Updated' },
].filter((x): x is { value: string; label: string } => x !== null);

// Search results show about 160 characters.
const article = /^[aeiou]/i.test(t.category) ? 'an' : 'a';
const baseDescription = t.seoDescription ?? `${t.name} is ${article} ${t.category.toLowerCase()} Framer template by ${site.name}. ${t.description}`;
// The code note goes last but must survive the cut, so the base text is shortened to make room for it.
const codeNote = codeUrl ? ' Also as Astro code.' : '';
const room = 160 - codeNote.length;
const description = (baseDescription.length > room ? baseDescription.slice(0, room - 3).replace(/\s+\S*$/, '') + '…' : baseDescription) + codeNote;
const templateKind = t.pageKind ?? t.category;
// A code version is named in the title too: it is the only page that answers "Astro template" searches.
const title = `${t.name} — ${free ? 'Free ' : ''}Framer ${templateKind} Template${free ? '' : ` ($${t.price})`}${codeUrl ? ' + Astro Code' : ''}`;

// The imported intro often starts with a one-line headline, followed by the real text.
const leadHead = c.leadTitle ?? (c.lead.length > 1 && c.lead[0].length < 110 ? c.lead[0] : undefined);
const leadText = c.leadTitle ? c.lead : leadHead ? c.lead.slice(1) : c.lead;
---

<Base
  title={title}
  description={description}
  image={ogPath}
  jsonLd={{
    '@context': 'https://schema.org',
    '@graph': [
      {
        // CreativeWork, not Product: the site sells nothing itself, so Google should not
        // treat template pages as merchant listings (no offers, ratings or shipping).
        '@type': 'CreativeWork',
        name: `${t.name}: ${t.tagline}`,
        description: t.description,
        image: new URL(ogPath, Astro.site).href,
        url: pageUrl,
        genre: `${t.category} Framer template`,
        isAccessibleForFree: t.price === 0,
        creator: { '@type': 'Organization', name: site.name, url: new URL('/', Astro.site).href },
        sameAs: t.url,
      },
      {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
          { '@type': 'ListItem', position: 2, name: 'Templates', item: new URL('/templates/', Astro.site).href },
          { '@type': 'ListItem', position: 3, name: t.name, item: pageUrl },
        ],
      },
      {
        '@type': 'FAQPage',
        mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: plainText(f.a) } })),
      },
    ],
  }}
>
  <Section class="section-with-bar" flush="bottom" label={`${t.name} template`}>
    <!-- The bar carries the breadcrumb, so the page starts on a line like every other page. -->
    <div class="section-bar type-label mb-0" data-reveal-skip>
      <nav aria-label="Breadcrumb">
        <a href="/" class="underline-offset-4 hover:underline">Home</a>
        <span aria-hidden="true" class="mx-2">/</span>
        <a href="/templates/" class="underline-offset-4 hover:underline">Templates</a>
        <span aria-hidden="true" class="mx-2">/</span>
        <span>{t.name}</span>
      </nav>
      <!-- Hidden on phones: no room next to the breadcrumb, and the kicker below says the same. -->
      <span class="hidden text-right sm:inline">{priceLabel} · {templateKind}</span>
    </div>

    <!-- A spec sheet on the page rails: the gallery on the left, everything about the template on
         the right, split by one vertical hairline. Each block on the right sits between two
         horizontal lines that run from that line to the rail. On phones: name, gallery, the rest. -->
    <div class="product flush-rails">
      <header class="p-head p-block">
        <p class="type-label">{free ? 'Free ' : ''}Framer {templateKind} template</p>
        <h1 class="type-headline-lg mt-lg break-words">{t.name}</h1>
        <p class="type-body type-pillar mt-lg">{t.tagline}</p>
      </header>

      <div class="p-gallery">
        <div class="p-gallery-inner">
          <TemplateGallery items={gallery} name={t.name} />
          <!-- The live preview belongs to the pictures: it sits right under them, not among the buy buttons. -->
          {t.preview && (
            <Button href={t.preview} variant="secondary" arrow target="_blank" rel="noopener noreferrer" class="mt-lg">
              View live preview
            </Button>
          )}
        </div>
      </div>

      <!-- Right: everything about the template. -->
      <div class="doc p-doc">
        <div class="buy p-block">
          <p class="type-label">Price</p>
          <p class="type-headline-md mt-sm">{priceLabel}</p>
          <!-- The two ways to get the template sit side by side. -->
          <div class="buy-actions">
            <Button href={buy.href} arrow target="_blank" rel={buy.sponsored ? 'noopener noreferrer sponsored' : 'noopener noreferrer'}>
              {framerLabel}
            </Button>
            {codeUrl && (
              <Button href={codeUrl} variant="secondary" arrow target="_blank" rel="noopener noreferrer">
                Buy code · {codePriceLabel}
              </Button>
            )}
          </div>
        </div>

        <dl class="stats">
          {stats.map((s) => (
            <div class="stat">
              <dt class="stat-label">{s.label}</dt>
              <dd class="stat-value">{s.value}</dd>
            </div>
          ))}
        </dl>

        {editorial ? (
          <div class="lead p-block">
            <h2 class="lead-head">{templateKind} template for Framer</h2>
            <p>{editorial.overview}</p>
          </div>
        ) : (leadHead || leadText.length > 0) && (
          <div class="lead p-block">
            {leadHead && <h2 class="lead-head">{leadHead}</h2>}
            {leadText.map((p) => <p set:html={richText(p)} />)}
          </div>
        )}

        {codeUrl && (
          <section class="doc-section p-block" aria-labelledby="code-version">
            <h2 class="kicker" id="code-version">Code version</h2>
            <div class="body-text">
              <p>
                Prefer not to use Framer? {t.name} also comes as a clean Astro and Tailwind CSS project: the same design,
                on phone, tablet and desktop, as code you own and host anywhere.
              </p>
            </div>
            <ul class="checks mt-lg">
              <li><Icon name="check" class="check" /><span>Every text, link and price in one file, so you edit content without touching the layout</span></li>
              <li><Icon name="check" class="check" /><span>Static build: no framework runtime, deploys to Cloudflare, Netlify, Vercel or your own server</span></li>
              <li><Icon name="check" class="check" /><span>README with setup and deploy steps, license and changelog included</span></li>
              <li><Icon name="check" class="check" /><span>One-time payment{t.codeVersion ? `, version ${t.codeVersion}` : ''}, sold through Contra. A digital product: all sales are final</span></li>
            </ul>
            <div class="buy-actions">
              <Button href={codeUrl} arrow target="_blank" rel="noopener noreferrer">
                Buy code · {codePriceLabel}
              </Button>
              <Button href="/license/" variant="secondary">Read the license</Button>
            </div>
          </section>
        )}

        <section class="doc-section p-block" aria-labelledby="before-you-publish">
          <h2 class="kicker" id="before-you-publish">Before you publish</h2>
          <div class="body-text">
            {t.preparation && <p>{t.preparation}</p>}
            <p>
              The free Framer plan publishes on a framer.website address. Your own domain needs a paid site plan, from
              Basic: <a href={site.framerReferral} class="link" target="_blank" rel="noopener noreferrer sponsored">see Framer plans</a>,
              or compare them in <a href="/guides/framer-pricing/" class="link">Framer pricing explained</a>.
            </p>
            <p>
              Step by step, with costs: <a href="/guides/how-to-use-framer-templates/" class="link">how to use a Framer template</a>.
              Questions about this template? <a href={`mailto:${site.email}`} class="link">Write to the author</a>.
            </p>
          </div>
        </section>

        {c.about.length > 0 && (
          <section class="doc-section p-block" aria-labelledby="about">
            <h2 class="kicker" id="about">About</h2>
            <div class="big-text">
              {c.about.map((p) => <p set:html={richText(p)} />)}
            </div>
          </section>
        )}

        {c.benefits.length > 0 && (
          <section class="doc-section p-block" aria-labelledby="benefits">
            <h2 class="kicker" id="benefits">{c.benefitsTitle}</h2>
            <ol class="benefits">
              {c.benefits.map((b, i) => (
                <li>
                  <span class="benefit-num" aria-hidden="true">{pad(i + 1)}</span>
                  <div>
                    <h3>{b.title}</h3>
                    <p set:html={richText(b.text)} />
                  </div>
                </li>
              ))}
            </ol>
          </section>
        )}

        {c.blocks.map((b) => (
          <section class="doc-section p-block" aria-labelledby={b.id}>
            <h2 class="kicker" id={b.id}>{b.title}</h2>
            {b.kind === 'text' && (
              <div class="body-text">
                {b.paragraphs.map((p) => <p set:html={richText(p)} />)}
              </div>
            )}
            {(b.kind === 'features' || b.kind === 'included' || b.kind === 'list') && (
              <ul class:list={['checks', b.kind === 'features' && 'checks-2']}>
                {b.items.map((item) => (
                  <li>
                    <Icon name="check" class="check" />
                    <span set:html={richText(item)} />
                  </li>
                ))}
              </ul>
            )}
            {(b.kind === 'pages' || b.kind === 'sections') && (
              <ol class="pages">
                {b.items.map((item, i) => (
                  <li>
                    <span class="pages-num" aria-hidden="true">{pad(i + 1)}</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ol>
            )}
            {b.kind === 'bestFor' && (
              <ul class="flex flex-wrap gap-2">
                {b.items.map((item) => <li class="tag">{item}</li>)}
              </ul>
            )}
          </section>
        ))}

        {(t.framerFeatures.length > 0 || t.styles.length > 0) && (
          <section class="doc-section p-block" aria-labelledby="built-with">
            <h2 class="kicker" id="built-with">Built with Framer</h2>
            {t.framerFeatures.length > 0 && (
              <ul class="flex flex-wrap gap-2">
                {t.framerFeatures.map((f) => <li class="tag tag-solid">{f}</li>)}
              </ul>
            )}
            {t.styles.length > 0 && (
              <>
                <p class="mini-label">Style</p>
                <ul class="flex flex-wrap gap-2">
                  {t.styles.map((s) => <li class="tag">{s}</li>)}
                </ul>
              </>
            )}
          </section>
        )}

        {c.updates.length > 0 && (
          <section class="doc-section p-block" aria-labelledby="updates">
            <h2 class="kicker" id="updates">Updates</h2>
            <ol class="timeline">
              {c.updates.map((u) => (
                <li>
                  <h3>{u.title}</h3>
                  <ul>
                    {u.items.map((item) => <li set:html={richText(item)} />)}
                  </ul>
                </li>
              ))}
            </ol>
          </section>
        )}

        {c.support && (
          <section class="doc-section p-block" aria-labelledby="support">
            <h2 class="kicker" id="support">Support</h2>
            <p class="body-text support" set:html={richText(c.support)} />
          </section>
        )}

        {c.policy && (
          <section class="doc-section p-block" aria-labelledby="policy">
            <h2 class="kicker" id="policy">{c.policy.title}</h2>
            <p class="body-text support" set:html={richText(c.policy.text)} />
          </section>
        )}
      </div>
    </div>
  </Section>

  <FaqBlock title="Questions." accent="Questions" bar={{ left: 'FAQ', right: `${String(faq.length).padStart(2, '0')} answers` }}>
    {faq.map((f) => <FaqItem question={f.q}><Fragment set:html={richText(f.a)} /></FaqItem>)}
  </FaqBlock>

  <!-- Closing band: the one large black block of the page, on light rails. -->
  <CtaBand labelledby="get-title">
    <span class="type-label mb-lg block">{priceLabel} on {buy.shop}</span>
    <h2 id="get-title" class="type-headline-lg"><em class="type-accent">Get</em> {t.name}.</h2>
    <div class="buy-actions">
      <Button href={buy.href} variant="secondary" arrow target="_blank" rel={buy.sponsored ? 'noopener noreferrer sponsored' : 'noopener noreferrer'}>
        {framerLabel}
      </Button>
      {codeUrl && (
        <Button href={codeUrl} variant="secondary" arrow target="_blank" rel="noopener noreferrer">
          Buy code · {codePriceLabel}
        </Button>
      )}
    </div>
    <div slot="media" class="border-(length:--border-frame) border-on-primary">
      <Image src={t.image} alt="" widths={[640, 960, 1400]} sizes="(min-width: 1024px) 50vw, 100vw" class="aspect-[4/3] w-full object-cover" />
    </div>
  </CtaBand>

  {others.length > 0 && (
    <Section labelledby="more-title" flush="bottom" bar={{ left: 'Catalog', right: `${String(others.length).padStart(2, '0')} more` }}>
      <SectionHeader id="more-title" title="More templates." accent="More">
        <Button href="/templates/" variant="secondary" arrow>View all</Button>
      </SectionHeader>
      <ul class="card-grid flush-rails">
        {others.map((o) => <TemplateCard template={o} />)}
      </ul>
    </Section>
  )}
</Base>

<style>
  /* The page reads like a spec sheet: numbered sections, hairlines instead of boxes, labels in
     capitals. Imported Marketplace text is long, so it uses the prose measure, not the pillar. */
  .doc {
    min-width: 0;
  }

  /* Product grid on the rails. Phones: one column. From 1024px: gallery | details, split by the
     center hairline; the gallery stays in view while the details scroll. */
  .product {
    display: grid;
    /* minmax(0, 1fr): an implicit auto column grows to its widest content and pushes the page past the phone screen. */
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'head' 'gallery' 'doc';
    /* Same place as the page rails: keeps them visible past the opaque stat cells. */
    border-inline: var(--border-hairline) solid var(--color-line);
  }
  .p-head { grid-area: head; }
  .p-doc { grid-area: doc; }
  .p-gallery {
    grid-area: gallery;
    padding: var(--spacing-xl) var(--rail-inset);
    border-top: var(--border-hairline) solid var(--color-line);
  }
  /* One block of the right column: generous padding, a line above it from edge to edge. */
  .p-block {
    padding: var(--spacing-xl) var(--rail-inset);
    border-top: var(--border-hairline) solid var(--color-line);
  }
  .p-head {
    border-top: 0;
  }
  @media (min-width: 64rem) {
    .product {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-areas: 'gallery head' 'gallery doc';
    }
    .p-head,
    .p-doc {
      border-left: var(--border-hairline) solid var(--color-line);
    }
    .p-gallery {
      border-top: 0;
    }
    .p-gallery-inner {
      position: sticky;
      top: calc(var(--space-header) + var(--spacing-xl));
    }
  }
  .buy-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
    margin-top: var(--spacing-lg);
  }

  /* numbers: cells sharing one hairline */
  .stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--border-hairline);
    background: var(--color-line);
    border-top: var(--border-hairline) solid var(--color-line);
  }
  .stat {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--spacing-xl);
    padding: var(--spacing-lg) var(--rail-inset);
    background: var(--color-surface);
  }
  .stat-label {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    line-height: var(--leading-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }
  .stat-value {
    font-size: var(--text-headline-sm);
    line-height: var(--leading-headline);
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-stretch: var(--display-stretch);
    letter-spacing: var(--tracking-headline);
    white-space: nowrap;
  }

  /* text blocks */

  .lead-head,
  .kicker {
    font-size: var(--text-headline-sm);
    line-height: var(--leading-headline);
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-stretch: var(--display-stretch);
    letter-spacing: var(--tracking-headline);
  }
  .kicker {
    margin-bottom: var(--spacing-lg);
  }
  .lead p,
  .body-text p,
  .big-text p {
    max-width: var(--container-prose);
    margin-top: var(--spacing-md);
    line-height: 1.25;
  }

  .big-text p:first-child {
    margin-top: 0;
    font-size: var(--text-headline-xs);
    line-height: 1.1;
    letter-spacing: var(--tracking-body);
  }
  /* Links inside the imported text (not buttons). */
  .doc :global(a:not(.btn)) {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .doc :global(a:not(.btn):hover) {
    text-decoration-thickness: 2px;
  }

  /* numbered benefits */
  .benefits li {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: var(--spacing-xs);
    padding: var(--spacing-lg) 0;
    border-top: var(--border-hairline) solid var(--color-line);
  }
  .benefits li:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .benefit-num {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    font-variant-numeric: tabular-nums;
  }
  .benefits h3,
  .timeline h3 {
    font-size: var(--text-headline-xxs);
    line-height: 1.1;
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-stretch: var(--display-stretch);
    letter-spacing: var(--tracking-headline);
  }
  .benefits p {
    margin-top: var(--spacing-xs);
    line-height: 1.25;
  }

  /* check lists */
  .checks {
    display: grid;
    gap: var(--spacing-md) var(--grid-gutter);
  }
  @media (min-width: 48rem) {
    .checks-2 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .checks li {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-sm);
    line-height: 1.25;
  }
  /* The icon is drawn by the Icon component, so the page's scoped styles need :global here. */
  .checks :global(.check) {
    flex: none;
    width: 1.125rem;
    height: 1.125rem;
  }

  /* pages */
  .pages {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--grid-gutter);
    border-top: var(--border-hairline) solid var(--color-line);
  }
  .pages li {
    font-family: var(--font-mono);
    display: flex;
    gap: var(--spacing-md);
    padding: var(--spacing-sm) 0;
    border-bottom: var(--border-hairline) solid var(--color-line);
    font-size: var(--text-label);
    line-height: var(--leading-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }
  .pages-num {
    font-variant-numeric: tabular-nums;
  }

  .mini-label {
    font-family: var(--font-mono);
    margin: var(--spacing-lg) 0 var(--spacing-sm);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  /* updates: a vertical hairline with square marks */
  .timeline {
    margin-left: 4px;
    padding-left: var(--spacing-lg);
    border-left: var(--border-hairline) solid var(--color-line);
  }
  .timeline > li {
    position: relative;
  }
  .timeline > li + li {
    margin-top: var(--spacing-lg);
  }
  .timeline > li::before {
    content: '';
    position: absolute;
    left: calc(-1 * var(--spacing-lg) - 4.5px);
    top: 2px;
    width: 8px;
    height: 8px;
    background: var(--color-primary);
  }
  .timeline ul {
    margin-top: var(--spacing-sm);
    display: grid;
    gap: var(--spacing-xs);
  }
  .timeline ul li {
    line-height: 1.25;
  }
  .support {
    margin-top: 0;
  }
</style>
