---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Button from '../components/Button.astro';
import TemplateCard from '../components/TemplateCard.astro';

// Old links to a renamed template land here most often, so the templates are shown right away.
const templates = (await getCollection('templates')).sort((a, b) => b.data.added.getTime() - a.data.added.getTime());
---

<Base title="Page not found">
  <Section labelledby="nf-title" class="text-center">
    <p class="type-display" aria-hidden="true">404</p>
    <h1 id="nf-title" class="type-headline-lg mt-xl">Off the grid.</h1>
    <p class="type-body type-pillar mx-auto mt-lg">This page is not in the catalog. Every template still is.</p>
    <div class="mt-xl flex flex-wrap justify-center gap-sm">
      <Button href="/templates/" arrow>Explore</Button>
      <Button href="/" variant="secondary">Home</Button>
    </div>
  </Section>

  <Section labelledby="nf-list-title" rule>
    <SectionHeader id="nf-list-title" kicker="Catalog" title="Templates." />
    <ul class="grid-4 gap-y-xl">
      {templates.map((t) => <TemplateCard template={t} class="col-span-4 md:col-span-2" />)}
    </ul>
  </Section>
</Base>
