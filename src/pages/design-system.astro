---
// Living style guide. Every token is read from src/styles/global.css at build time,
// so this page can never drift from the real values. Only in `npm run dev`.
import { readFileSync } from 'node:fs';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import FaqItem from '../components/FaqItem.astro';
import Band from '../components/Band.astro';
import Icon from '../components/Icon.astro';
import Logo from '../components/Logo.astro';
import TemplateCard from '../components/TemplateCard.astro';
import { icons, type IconName } from '../components/icons';

type Token = { name: string; value: string; note: string; small?: string };

const css = readFileSync('src/styles/global.css', 'utf8');
const themeBlock = css.match(/@theme static \{([\s\S]*?)\n\}/)?.[1] ?? '';
const smallBlock = css.match(/@media \(max-width: 47\.99rem\) \{\s*:root \{([\s\S]*?)\}/)?.[1] ?? '';

const small = new Map<string, string>();
for (const m of smallBlock.matchAll(/(--[\w-]+):\s*([^;]+);/g)) small.set(m[1], m[2].trim());

const tokens: Token[] = [...themeBlock.matchAll(/^\s*(--[\w-]+):\s*([^;]+);(?:\s*\/\*\s*(.*?)\s*\*\/)?/gm)]
  .filter((m) => m[2].trim() !== 'initial')
  .map((m) => ({ name: m[1], value: m[2].trim(), note: m[3] ?? '', small: small.get(m[1]) }));
const group = (...prefixes: string[]) => tokens.filter((t) => prefixes.some((p) => t.name.startsWith(p)));

const sections = [
  { title: 'Spacing', items: group('--spacing-') },
  { title: 'Lines', items: group('--border-') },
  { title: 'Layout', items: group('--container-', '--grid-', '--space-') },
  { title: 'Type', items: group('--text-', '--leading-', '--tracking-', '--font-') },
  { title: 'Motion', items: group('--duration-', '--ease-') },
];
const colors = group('--color-');

const typeRoles = [
  { cls: 'type-display', sample: 'Framer templates.', use: 'headline-display, one per page' },
  { cls: 'type-headline-lg', sample: 'Zero code.', use: 'headline-lg, section titles' },
  { cls: 'type-headline-md', sample: 'Selected work', use: 'headline-md, big numbers' },
  { cls: 'type-headline-sm', sample: 'Softic Studio', use: 'headline-sm, template names, blocks' },
  { cls: 'type-headline-xs', sample: 'Responsive', use: 'headline-xs, card titles' },
  { cls: 'type-headline-xxs', sample: 'Is it free?', use: 'headline-xxs, small titles, FAQ' },
  { cls: 'type-body type-pillar', sample: 'Ready-made websites, set in Framer. Pick one, remix it, publish it today.', use: 'body-md in a pillar, short copy' },
  { cls: 'type-label', sample: '01 / Templates', use: 'label-md, labels, tags, buttons, nav' },
];

const templates = await getCollection('templates');
const sample = templates[0];
const iconNames = Object.keys(icons) as IconName[];
---

<Base title="Design system" description="Vonex Design system: tokens, type scale, 4-column grid and components" noindex gridOverlay>
  <Section labelledby="ds-title">
    <SectionHeader
      id="ds-title"
      level={1}
      kicker="Alpine"
      title="Design system."
      lead="Black on white. Inter. Square corners. Hairlines, no shadows. Press G for the grid."
    />
    <button type="button" data-grid-toggle class="btn btn-secondary">Toggle grid</button>
  </Section>

  <Section labelledby="ds-colors" rule>
    <SectionHeader id="ds-colors" index={1} kicker="Color" title="Two values." />
    <ul class="cells cells-4">
      {
        colors.map((c) => (
          <li class="cell">
            <div class="frame-hairline h-24" style={`background:var(${c.name})`} />
            <p class="type-headline-xxs mt-md">{c.name}</p>
            <p class="type-label mt-xs">{c.value}</p>
            <p class="type-body mt-sm">{c.note}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section labelledby="ds-type" rule>
    <SectionHeader id="ds-type" index={2} kicker="Type" title="One family." />
    <ul class="border-t border-line">
      {
        typeRoles.map((r) => (
          <li class="grid-4 border-b border-line py-lg">
            <div class="col-span-4 lg:col-span-1">
              <p class="type-label">.{r.cls.split(' ')[0]}</p>
              <p class="type-body mt-xs">{r.use}</p>
            </div>
            <p class:list={[r.cls, 'col-span-4 lg:col-span-3 break-words']}>{r.sample}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section labelledby="ds-grid" rule>
    <SectionHeader id="ds-grid" index={3} kicker="Grid" title="Four columns." lead="24px gutters, 16px on phones. Spans: 4, 2 + 2, 1 + 3, 1 × 4." />
    <div class="grid-4">
      {[['col-span-4', '4'], ['col-span-2', '2'], ['col-span-2', '2'], ['col-span-1', '1'], ['col-span-3', '3'], ['col-span-1', '1'], ['col-span-1', '1'], ['col-span-1', '1'], ['col-span-1', '1']].map(([cls, label]) => (
        <div class:list={[cls, 'card card-padding type-label']}>{label}</div>
      ))}
    </div>
  </Section>

  <Section labelledby="ds-components" rule>
    <SectionHeader id="ds-components" index={4} kicker="Components" title="Parts." />
    <div class="grid-4 gap-y-xl">
      <div class="col-span-4 lg:col-span-1">
        <p class="type-headline-xxs mb-lg">Button</p>
        <div class="flex flex-wrap gap-sm">
          <Button arrow>Explore</Button>
          <Button variant="secondary">View</Button>
          <Button size="compact">Order</Button>
        </div>
      </div>
      <div class="col-span-4 lg:col-span-1">
        <p class="type-headline-xxs mb-lg">Tag</p>
        <ul class="flex flex-wrap gap-xs">
          <li class="tag">Portfolio</li>
          <li class="tag tag-solid">$49</li>
          <li class="tag">Free</li>
        </ul>
      </div>
      <div class="col-span-4 lg:col-span-1">
        <p class="type-headline-xxs mb-lg">Input</p>
        <label class="type-label mb-xs block" for="ds-input">Email</label>
        <input id="ds-input" class="input" placeholder="you@example.com" />
      </div>
      <div class="col-span-4 lg:col-span-1">
        <p class="type-headline-xxs mb-lg">Icon</p>
        <ul class="flex flex-wrap gap-md">
          {iconNames.map((n) => <li title={n}><Icon name={n} class="size-6" /></li>)}
          <li title="logo"><Logo class="h-6 w-auto" /></li>
        </ul>
      </div>

      <Card class="col-span-4 md:col-span-2">
        <p class="type-label">Card</p>
        <p class="type-headline-xs mt-xl">Surface, hairline, 20px.</p>
      </Card>
      <div class="col-span-4 md:col-span-2">
        <p class="type-headline-xxs mb-lg">FAQ</p>
        <div class="faq-list">
          <FaqItem question="Do I need to know how to code?">No. Everything is edited visually in Framer.</FaqItem>
        </div>
      </div>

      <ul class="cells cells-4 col-span-4">
        {['01', '02', '03', '04'].map((n) => <li class="cell"><p class="type-label">{n}</p><p class="type-headline-lg mt-xl">0</p><p class="type-body mt-sm">Cells share one hairline.</p></li>)}
      </ul>

      {sample && (
        <ul class="card-grid col-span-4">
          <TemplateCard template={sample} />
        </ul>
      )}
    </div>
  </Section>

  <Band items={['Form.', 'Function.', 'Force.']} />

  <Section labelledby="ds-tokens">
    <SectionHeader id="ds-tokens" index={5} kicker="Tokens" title="Every value." lead="Read from global.css at build time." />
    {
      sections.map((s) => (
        <div class="mb-xl">
          <p class="type-headline-xs mb-lg">{s.title}</p>
          <table class="type-body w-full border-t border-line text-left">
            <tbody>
              {s.items.map((t) => (
                <tr class="border-b border-line align-top">
                  <td class="type-label py-sm pr-lg">{t.name}</td>
                  <td class="py-sm pr-lg">{t.value}{t.small && <span class="block mt-xs">Phone: {t.small}</span>}</td>
                  <td class="hidden py-sm md:table-cell">{t.note}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ))
    }
  </Section>
</Base>
