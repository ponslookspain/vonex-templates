---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GridOverlay from '../components/GridOverlay.astro';
// Preload the Latin subset of the font: it is needed for the first paint.
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  // Home page only: the hero fills the first screen and sits under the fixed header.
  overlayHeader?: boolean;
  // Extra structured data (JSON-LD) for this page.
  jsonLd?: Record<string, unknown>;
  // Keep the page out of search results (internal pages such as the design system).
  noindex?: boolean;
  // Social preview image (path from the site root, 1200x630). Defaults to the site image.
  image?: string;
  // Include the 12-column grid overlay (toggle with the G key). Always on in dev.
  gridOverlay?: boolean;
}
const { title, description = site.description, overlayHeader = false, jsonLd, noindex = false, gridOverlay = false, image = '/og-image.png' } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name}: ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site).href;
const siteSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.name,
    url: new URL('/', Astro.site).href,
    description: site.description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: site.name,
    url: new URL('/', Astro.site).href,
    logo: new URL('/icon-512.png', Astro.site).href,
    email: site.email,
    sameAs: [site.framerProfile, ...site.socials.map((s) => s.href)],
  },
];
const schemas = jsonLd ? [...siteSchema, jsonLd] : siteSchema;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta name="theme-color" content="#000000" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {schemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
    {
      site.analyticsToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: site.analyticsToken })}
        />
      )
    }
  </head>
  <body class="min-h-dvh flex flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-control focus:bg-fg focus:px-3 focus:py-2 focus:text-bg"
      >Skip to content</a
    >
    <Header />
    <main id="main" class:list={['flex-1', !overlayHeader && 'pt-28 md:pt-20']}>
      <slot />
    </main>
    <Footer />
    {(gridOverlay || import.meta.env.DEV) && <GridOverlay />}
    <script is:inline>
      // Scroll reveal: every block of a section fades up once as it comes into view. Blocks in
      // the same row follow each other by a short delay. Marking happens here, before the first
      // paint, so nothing flashes. If anything fails, everything is shown after 3 seconds.
      (function () {
        var root = document.documentElement;
        if (!('IntersectionObserver' in window)) { root.classList.remove('js'); return; }
        var targets = [];
        // Layout wrappers are transparent: their children are what appears.
        var wrapper = '.grid-12, .doc, .faq-list';
        function collect(el) {
          var i = 0;
          for (var c = el.firstElementChild; c; c = c.nextElementSibling) {
            if (c.matches(wrapper)) { collect(c); continue; }
            c.setAttribute('data-reveal', '');
            c.style.setProperty('--reveal-delay', Math.min(i, 6) * 80 + 'ms');
            targets.push(c);
            i++;
          }
        }
        document.querySelectorAll('main .container-page, footer .container-page').forEach(collect);
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting || e.boundingClientRect.bottom < 0) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          });
        }, { rootMargin: '0px 0px -8% 0px' });
        targets.forEach(function (t) { io.observe(t); });
        setTimeout(function () { targets.forEach(function (t) { t.classList.add('is-visible'); }); }, 3000);
      })();
    </script>
    <script>
      // Mark decorative blocks as off screen so their CSS animations pause.
      const blocks = document.querySelectorAll('[data-pause-offscreen]');
      if (blocks.length && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) e.target.toggleAttribute('data-offscreen', !e.isIntersecting);
        }, { rootMargin: '100px' });
        blocks.forEach((b) => io.observe(b));
      }
    </script>
  </body>
</html>
