---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GridOverlay from '../components/GridOverlay.astro';
// Preload the Latin subset of the font: it is needed for the first paint.
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import monoLatin from '@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url';
import serifLatin from '@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2?url';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  // Extra structured data (JSON-LD) for this page.
  jsonLd?: Record<string, unknown>;
  // Keep the page out of search results (internal pages such as the design system).
  noindex?: boolean;
  // Social preview image (path from the site root, 1200x630). Defaults to the site image.
  image?: string;
  // Include the 4-column grid overlay (toggle with the G key). Always on in dev.
  gridOverlay?: boolean;
}
const { title, description = site.description, jsonLd, noindex = false, gridOverlay = false, image = '/og-image.png' } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name}: ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site).href;
const siteSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.name,
    url: new URL('/', Astro.site).href,
    description: site.description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: site.name,
    url: new URL('/', Astro.site).href,
    logo: new URL('/icon-512.png', Astro.site).href,
    email: site.email,
    sameAs: [site.framerProfile, ...site.socials.map((s) => s.href)],
  },
];
const schemas = jsonLd ? [...siteSchema, jsonLd] : siteSchema;
const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION?.trim();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    {site.bingSiteVerification && <meta name="msvalidate.01" content={site.bingSiteVerification} />}
    {site.pinterestDomainVerify && <meta name="p:domain_verify" content={site.pinterestDomainVerify} />}
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifLatin} as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta name="theme-color" content="#f2f1ee" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {schemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
    {
      import.meta.env.PROD && site.analyticsToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: site.analyticsToken })}
        />
      )
    }
    {
      import.meta.env.PROD && site.umamiWebsiteId && (
        <Fragment>
          {/* Opening any page with ?analytics=off keeps this browser out of the stats, ?analytics=on undoes it. */}
          <script is:inline>
            try {
              const analytics = new URLSearchParams(location.search).get('analytics');
              if (analytics === 'off') localStorage.setItem('umami.disabled', '1');
              if (analytics === 'on') localStorage.removeItem('umami.disabled');
            } catch {}
          </script>
          <script
            is:inline
            defer
            src="https://cloud.umami.is/script.js"
            data-website-id={site.umamiWebsiteId}
            data-domains="vonexdesign.com"
          />
        </Fragment>
      )
    }
  </head>
  <body class="min-h-dvh flex flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:bg-primary focus:px-sm focus:py-xs focus:text-on-primary"
      >Skip to content</a
    >
    <Header />
    <main id="main" class="page-rails flex-1 pt-(--space-header)">
      <slot />
    </main>
    <Footer />
    {(gridOverlay || import.meta.env.DEV) && <GridOverlay />}
    <script is:inline>
      // Scroll reveal: every block of a section fades up once as it comes into view. Blocks in
      // the same row follow each other by a short delay. Marking happens here, before the first
      // paint, so nothing flashes. Blocks already on screen when the page opens are left alone:
      // the first view appears at once (no fade holding back the largest paint), and only what
      // you scroll to animates. If the observer never answers, everything is shown after 3 s.
      (function () {
        var root = document.documentElement;
        if (!('IntersectionObserver' in window)) { root.classList.remove('js'); return; }
        var targets = [];
        var fold = window.innerHeight;
        // Layout wrappers are transparent: their children are what appears.
        var wrapper = '.grid-4, .doc, .faq-list';
        // Read every position first and write afterwards, so the page lays out only once.
        var found = [];
        function collect(el) {
          var row = [];
          for (var c = el.firstElementChild; c; c = c.nextElementSibling) {
            if (c.matches(wrapper)) { collect(c); continue; }
            if (c.matches('.column-lines, [data-reveal-skip]')) continue;
            row.push(c);
          }
          if (row.length) found.push(row);
        }
        document.querySelectorAll('main .container-page, footer .container-page').forEach(collect);
        var tops = found.map(function (row) { return row.map(function (c) { return c.getBoundingClientRect().top; }); });
        found.forEach(function (row, r) {
          var i = 0;
          row.forEach(function (c, k) {
            if (tops[r][k] < fold) return;
            c.setAttribute('data-reveal', '');
            c.style.setProperty('--reveal-delay', 'calc(var(--reveal-stagger) * ' + Math.min(i, 6) + ')');
            targets.push(c);
            i++;
          });
        });
        var answered = false;
        var io = new IntersectionObserver(function (entries) {
          answered = true;
          entries.forEach(function (e) {
            if (e.isIntersecting || e.boundingClientRect.bottom < 0) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          });
        }, { rootMargin: '0px 0px -8% 0px' });
        targets.forEach(function (t) { io.observe(t); });
        setTimeout(function () { if (!answered) targets.forEach(function (t) { t.classList.add('is-visible'); }); }, 3000);
      })();
    </script>
    <script>
      // Mark decorative blocks as off screen so their CSS animations pause.
      const blocks = document.querySelectorAll('[data-pause-offscreen]');
      if (blocks.length && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) e.target.toggleAttribute('data-offscreen', !e.isIntersecting);
        }, { rootMargin: '100px' });
        blocks.forEach((b) => io.observe(b));
      }
    </script>
  </body>
</html>
