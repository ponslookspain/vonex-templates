{
  // Separate Cloudflare Workers project (static assets only). Not related to PostVIA.
  "name": "vonex-templates",
  "compatibility_date": "2026-10-01",
  // Custom domain bought on Cloudflare. DNS and the certificate are created on deploy.
  "routes": [
    { "pattern": "vonexdesign.com", "custom_domain": true },
    { "pattern": "www.vonexdesign.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
